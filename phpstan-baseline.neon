parameters:
	ignoreErrors:
		-
			message: '#^Strict comparison using \=\=\= between false and int will always evaluate to false\.$#'
			identifier: identical.alwaysFalse
			count: 1
			path: build/php74/Parser/Analysis/CaptureFacts.php

		-
			message: '#^Strict comparison using \=\=\= between false and string will always evaluate to false\.$#'
			identifier: identical.alwaysFalse
			count: 1
			path: build/php74/Parser/Analysis/CaptureFacts.php

		-
			message: '#^Call to function is_array\(\) with list\<string\> will always evaluate to true\.$#'
			identifier: function.alreadyNarrowedType
			count: 1
			path: build/php74/Parser/Analysis/CaptureShapeAnalyzer.php

		-
			message: '#^Ternary operator condition is always true\.$#'
			identifier: ternary.alwaysTrue
			count: 1
			path: build/php74/Parser/Analysis/CaptureShapeAnalyzer.php

		-
			message: '#^Comparison operation "\>" between int\<1, 4\> and 128 is always false\.$#'
			identifier: greater.alwaysFalse
			count: 1
			path: build/php74/Parser/Analysis/LiteralExtractor.php

		-
			message: '#^PHPDoc tag @param for parameter \$bsr contains unresolvable type\.$#'
			identifier: parameter.unresolvableType
			count: 1
			path: build/php74/Parser/Analysis/PatternInfo.php

		-
			message: '#^PHPDoc tag @param for parameter \$newline contains unresolvable type\.$#'
			identifier: parameter.unresolvableType
			count: 1
			path: build/php74/Parser/Analysis/PatternInfo.php

		-
			message: '#^Parameter \$bsr of method PHPRegex\\Parser\\Analysis\\PatternInfo\:\:__construct\(\) has invalid type PHPRegex\\Parser\\Analysis\\PHPRegex\\Parser\\NewlineConvention\.$#'
			identifier: class.notFound
			count: 1
			path: build/php74/Parser/Analysis/PatternInfo.php

		-
			message: '#^Parameter \$newline of method PHPRegex\\Parser\\Analysis\\PatternInfo\:\:__construct\(\) has invalid type PHPRegex\\Parser\\Analysis\\PHPRegex\\Parser\\NewlineConvention\.$#'
			identifier: class.notFound
			count: 1
			path: build/php74/Parser/Analysis/PatternInfo.php

		-
			message: '#^Property PHPRegex\\Parser\\Analysis\\PatternInfo\:\:\$bsr \(PHPRegex\\Parser\\BsrConvention\|null\) does not accept PHPRegex\\Parser\\Analysis\\PHPRegex\\Parser\\NewlineConvention\|null\.$#'
			identifier: assign.propertyType
			count: 1
			path: build/php74/Parser/Analysis/PatternInfo.php

		-
			message: '#^Property PHPRegex\\Parser\\Analysis\\PatternInfo\:\:\$newline \(PHPRegex\\Parser\\NewlineConvention\|null\) does not accept PHPRegex\\Parser\\Analysis\\PHPRegex\\Parser\\NewlineConvention\|null\.$#'
			identifier: assign.propertyType
			count: 1
			path: build/php74/Parser/Analysis/PatternInfo.php

		-
			message: '#^Parameter \#11 \$newline of class PHPRegex\\Parser\\Analysis\\PatternInfo constructor expects PHPRegex\\Parser\\Analysis\\PHPRegex\\Parser\\NewlineConvention\|null, PHPRegex\\Parser\\NewlineConvention\|null given\.$#'
			identifier: argument.type
			count: 1
			path: build/php74/Parser/Analysis/PatternInfoAnalyzer.php

		-
			message: '#^Parameter \#12 \$bsr of class PHPRegex\\Parser\\Analysis\\PatternInfo constructor expects PHPRegex\\Parser\\Analysis\\PHPRegex\\Parser\\NewlineConvention\|null, PHPRegex\\Parser\\BsrConvention\|null given\.$#'
			identifier: argument.type
			count: 1
			path: build/php74/Parser/Analysis/PatternInfoAnalyzer.php

		-
			message: '#^Strict comparison using \=\=\= between false and int will always evaluate to false\.$#'
			identifier: identical.alwaysFalse
			count: 1
			path: build/php74/Parser/Engine/CharacterTables.php

		-
			message: '#^Call to function is_int\(\) with int will always evaluate to true\.$#'
			identifier: function.alreadyNarrowedType
			count: 1
			path: build/php74/Parser/Engine/LibraryPcre.php

		-
			message: '#^Call to function is_array\(\) with list\<int\> will always evaluate to true\.$#'
			identifier: function.alreadyNarrowedType
			count: 1
			path: build/php74/Parser/Hir/Properties.php

		-
			message: '#^Ternary operator condition is always true\.$#'
			identifier: ternary.alwaysTrue
			count: 1
			path: build/php74/Parser/Hir/Properties.php

		-
			message: '#^Parameter \#1 \$array \(list\<int\<0, 255\>\>\) of array_values is already a list, call has no effect\.$#'
			identifier: arrayValues.list
			count: 1
			path: build/php74/Parser/Hir/Utf8.php

		-
			message: '#^Expression on left side of \?\? is not nullable\.$#'
			identifier: nullCoalesce.expr
			count: 1
			path: build/php74/Parser/Lexer.php

		-
			message: '#^Negated boolean expression is always false\.$#'
			identifier: booleanNot.alwaysFalse
			count: 1
			path: build/php74/Parser/Lexer.php

		-
			message: '#^Static method PHPRegex\\Parser\\Printer\\DelimiterBrackets\:\:groupSpelling\(\) is unused\.$#'
			identifier: method.unused
			count: 1
			path: build/php74/Parser/Printer/DelimiterBrackets.php

		-
			message: '#^Comparison operation "\>\=" between 65663\|int\<131199, 1114111\> and 55296 is always true\.$#'
			identifier: greaterOrEqual.alwaysTrue
			count: 1
			path: build/php74/Parser/Printer/DisplayEscaper.php

		-
			message: '#^PHPDoc tag @param for parameter \$refusal contains unresolvable type\.$#'
			identifier: parameter.unresolvableType
			count: 1
			path: build/php74/Parser/Printer/FormatResult.php

		-
			message: '#^Variable \$type might not be defined\.$#'
			identifier: variable.undefined
			count: 1
			path: build/php74/Parser/Printer/NodeDumper.php

		-
			message: '#^Right side of && is always true\.$#'
			identifier: booleanAnd.rightAlwaysTrue
			count: 1
			path: build/php74/Parser/Printer/PatternPrinter.php

		-
			message: '#^Strict comparison using \=\=\= between false and int will always evaluate to false\.$#'
			identifier: identical.alwaysFalse
			count: 1
			path: build/php74/Parser/Printer/PatternPrinter.php

		-
			message: '#^Strict comparison using \!\=\= between null and int will always evaluate to true\.$#'
			identifier: notIdentical.alwaysTrue
			count: 1
			path: build/php74/Parser/Syntax/CodePointReader.php

		-
			message: '#^PHPDoc tag @param for parameter \$assertion contains unresolvable type\.$#'
			identifier: parameter.unresolvableType
			count: 1
			path: build/php74/Parser/Syntax/PcreVerb.php

		-
			message: '#^Parameter \#2 \$assertion of class PHPRegex\\Parser\\Syntax\\PcreVerb constructor expects PHPRegex\\Parser\\Syntax\\PHPRegex\\Parser\\ErrorCode\|null, PHPRegex\\Parser\\Node\\GroupType given\.$#'
			identifier: argument.type
			count: 1
			path: build/php74/Parser/Syntax/PcreVerb.php

		-
			message: '#^Parameter \$assertion of method PHPRegex\\Parser\\Syntax\\PcreVerb\:\:__construct\(\) has invalid type PHPRegex\\Parser\\Syntax\\PHPRegex\\Parser\\ErrorCode\.$#'
			identifier: class.notFound
			count: 1
			path: build/php74/Parser/Syntax/PcreVerb.php

		-
			message: '#^Property PHPRegex\\Parser\\Syntax\\PcreVerb\:\:\$assertion \(PHPRegex\\Parser\\Node\\GroupType\|null\) does not accept PHPRegex\\Parser\\Syntax\\PHPRegex\\Parser\\ErrorCode\|null\.$#'
			identifier: assign.propertyType
			count: 1
			path: build/php74/Parser/Syntax/PcreVerb.php

		-
			message: '#^PHPDoc tag @param for parameter \$code contains unresolvable type\.$#'
			identifier: parameter.unresolvableType
			count: 2
			path: build/php74/Parser/Token/TokenStream.php

		-
			message: '#^Parameter \#1 \$array \(list\<PHPRegex\\Parser\\Node\\NodeInterface\>\) of array_values is already a list, call has no effect\.$#'
			identifier: arrayValues.list
			count: 2
			path: build/php74/Parser/Validation/CompiledLength.php

		-
			message: '#^Expression "null" on a separate line does not do anything\.$#'
			identifier: expr.resultUnused
			count: 2
			path: build/php74/Parser/Validation/EscapeChecks.php

		-
			message: '#^Unreachable statement \- code above always terminates\.$#'
			identifier: deadCode.unreachable
			count: 1
			path: build/php74/Parser/Validation/EscapeChecks.php

		-
			message: '#^Instanceof between PHPRegex\\Parser\\Exception\\LexerException and PHPRegex\\Parser\\Exception\\LexerException will always evaluate to true\.$#'
			identifier: instanceof.alwaysTrue
			count: 1
			path: build/php74/Parser/Validation/FirstErrorLocator.php

		-
			message: '#^Property PHPRegex\\Parser\\Validation\\LookbehindChecks\:\:\$target is never read, only written\.$#'
			identifier: property.onlyWritten
			count: 1
			path: build/php74/Parser/Validation/LookbehindChecks.php

		-
			message: '#^PHPDoc tag @param for parameter \$category contains unresolvable type\.$#'
			identifier: parameter.unresolvableType
			count: 1
			path: build/php74/Parser/Validation/ValidationResult.php

		-
			message: '#^PHPDoc tag @param for parameter \$errorCode contains unresolvable type\.$#'
			identifier: parameter.unresolvableType
			count: 1
			path: build/php74/Parser/Validation/ValidationResult.php

		-
			message: '#^Strict comparison using \!\=\= between false and int\<0, max\> will always evaluate to true\.$#'
			identifier: notIdentical.alwaysTrue
			count: 1
			path: build/php74/Parser/Validation/Validator.php

		-
			message: '#^Strict comparison using \=\=\= between false and int will always evaluate to false\.$#'
			identifier: identical.alwaysFalse
			count: 1
			path: build/php74/Parser/Validation/Validator.php
