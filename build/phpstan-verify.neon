# The code that checks the twin, PHP 7.4 code like the twin: its tests and
# the readings it compares. It reads JSON the original wrote, so it is held
# to level 6, below the twin's max: every call, argument and return is
# checked, the decoded values are trusted.
parameters:
	level: 6
	phpVersion: 70400
	paths:
		- tests
		- verify
	tmpDir: ../.cache/phpstan-twin-verify
	bootstrapFiles:
		- smoke/vendor/autoload.php
	scanFiles:
		- corpus.php
		- smoke/vendor/symfony/polyfill-php80/bootstrap.php
		- smoke/vendor/symfony/polyfill-php80/Resources/stubs/Stringable.php
		- smoke/vendor/symfony/polyfill-php80/Resources/stubs/UnhandledMatchError.php
		- smoke/vendor/symfony/polyfill-php80/Resources/stubs/ValueError.php
		- smoke/vendor/symfony/polyfill-php81/bootstrap.php
