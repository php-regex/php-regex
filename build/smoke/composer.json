{
	"require": {
		"php": ">=7.4",
		"symfony/polyfill-php80": "^1.31",
		"symfony/polyfill-php81": "^1.31",
		"symfony/polyfill-mbstring": "^1.31",
		"psr/cache": "^1.0 || ^2.0 || ^3.0",
		"psr/simple-cache": "^1.0 || ^2.0 || ^3.0"
	},
	"autoload": {
		"psr-4": {
			"PHPRegex\\Parser\\": "../php74/src"
		}
	},
	"config": {
		"allow-plugins": false,
		"platform": {
			"php": "7.4.33"
		}
	},
	"require-dev": {
		"phpunit/phpunit": "^9.6"
	},
	"autoload-dev": {
		"psr-4": {
			"PHPRegex\\Build\\Tests\\": "../tests/",
			"PHPRegex\\Build\\Verify\\": "../verify/"
		}
	}
}
