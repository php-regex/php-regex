{
    "source": {
        "directories": [
            "src"
        ],
        "excludes": [
            "Exception",
            "Laravel",
            "Symfony",
            "PHPStan",
            "Psalm",
            "Rector",
            "Parser/.phpstorm.meta.php",
            "Redos/.phpstorm.meta.php",
            "Toolkit/.phpstorm.meta.php"
        ]
    },
    "timeout": 10,
    "tmpDir": ".cache",
    "threads": "max",
    "logs": {
        "text": ".cache/infection/infection.log",
        "summary": ".cache/infection/infection-summary.log",
        "json": ".cache/infection/infection-log.json",
        "html": ".cache/infection/infection-report.html"
    },
    "mutators": {
        "@default": true
    },
    "testFramework": "phpunit",
    "phpUnit": {
        "configDir": "."
    },
    "minMsi": 50,
    "minCoveredMsi": 90
}
