# Dependencies
/vendor/
/tools/**/vendor/
/build/smoke/vendor/
/composer.lock

# IDEs
/.idea/
/.vscode/

# Cache & Temporary Files
/.cache/
/.task/*
!/.task/
!/.task/.gitkeep
/.junie/
/.phpunit.result.cache
/.php-cs-fixer.cache
/.deptrac.cache
# The counts Tally keeps for its accept command, at the place it names
/tmp/tally/
/tests/**/.fixture.lock

# Build & Distribution
/bin/regex.phar
/bin/regex.phar.sha256
/coverage/
/wasm/pcre2-trace/build/
/wasm/php-wasm/build/

# Logs
*.log

# OS Generated Files
.DS_Store

# Local Configuration Overrides
/phpunit.xml
/phpstan.neon
/.php-cs-fixer.php

/corpus/*
!/corpus/
!/corpus/.gitkeep
/var/*
!/var/log/
/var/log/*
!/var/log/corpus.log
!/var/log/corpus-redos.log

# Mutation testing reports
/infection-mutations.log
/infection-mutations.html

# Local split tool (bin/split uses it when it is not on $PATH)
/bin/splitsh-lite
__pycache__/

# Jekyll site build artifacts
/docs/_site/
/docs/.sass-cache/
/docs/.jekyll-cache/
/docs/.jekyll-metadata

# Demo applications
/demo/*/vendor/
/demo/*/var/
/demo/*/node_modules/
