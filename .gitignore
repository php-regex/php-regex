# Dependencies
/vendor/
/tools/**/vendor/
/composer.lock

# IDEs
/.idea/
/.vscode/

# Cache & Temporary Files
/.cache/
/.task/*
!/.task/
!/.task/.gitkeep
/.junie/
/.phpunit.result.cache
/.php-cs-fixer.cache
/.deptrac.cache

# Build & Distribution
/build/
/coverage/

# Logs
*.log

# OS Generated Files
.DS_Store

# Local Configuration Overrides
/phpunit.xml
/phpstan.neon
/.php-cs-fixer.php

/corpus/*
!/corpus/
!/corpus/.gitkeep
/var/*
!/var/log/
/var/log/*
!/var/log/corpus.log
!/var/log/corpus-redos.log

# Mutation testing reports
/infection-mutations.log
/infection-mutations.html

# Local split tool (bin/split uses it when it is not on $PATH)
/bin/splitsh-lite
__pycache__/
