#!/usr/bin/env bash
#
# This file is part of the PHPRegex package.
#
# (c) Younes ENNAJI <younes.ennaji.pro@gmail.com>
#
# For the full copyright and license information, please view the LICENSE
# file that was distributed with this source code.
#
# Where the release stands: the version, the last tag, CI on HEAD, and for the
# split, the monorepo, its secrets, each php-regex/regex-* repository and each
# package on Packagist. Reads only.
#
# Usage:
#   bin/status [--offline] [--root <dir>]
#
#   --offline   the local part only: version, tag, branch and the packages
#   --root      the monorepo checkout to report on (default: the one holding this script)
#
# The marks are coloured only when the output is a terminal.
set -uo pipefail

offline=0
here="$(cd "$(dirname "$0")" && pwd)"
root="$(cd "$here/.." && pwd)"
while [ $# -gt 0 ]; do
    case "$1" in
        --offline) offline=1 ;;
        --root) root=${2:?--root needs a directory}; shift ;;
        -h|--help) sed -n '10,/^set -/p' "$0" | sed '$d' | sed 's/^# \{0,1\}//'; exit 0 ;;
        *) echo "Unknown option: $1" >&2; exit 2 ;;
    esac
    shift
done

# Colours for a terminal only: piped or redirected, the marks stay plain.
if [ -t 1 ]; then
    green=$'\033[32m' red=$'\033[31m' dim=$'\033[2m' reset=$'\033[0m'
else
    green='' red='' dim='' reset=''
fi
ok() { printf '  %s✓%s %s\n' "$green" "$reset" "$1"; }
ko() { printf '  %s✗%s %s\n' "$red" "$reset" "$1"; }
na() { printf '  %s·%s %s\n' "$dim" "$reset" "$1"; }

# The packages, as bin/split pushes them.
repositories=$(sed -nE 's/^[[:space:]]+"src\/[A-Za-z]+:([a-z-]+)"$/\1/p' "$here/split")

version=$(sed -nE "s/.*public const VERSION = '([^']+)';.*/\1/p" "$root/src/Toolkit/Regex.php")
echo "PHPRegex $version"
echo
echo "Repository"
branch=$(git -C "$root" rev-parse --abbrev-ref HEAD 2>/dev/null) && na "branch $branch" || na "not a git checkout"
last_tag=$(git -C "$root" describe --tags --abbrev=0 2>/dev/null) && na "last tag $last_tag" || na "no tag yet"
if [ -z "$(git -C "$root" status --porcelain 2>/dev/null)" ]; then ok "working tree clean"; else ko "working tree has changes"; fi
# How HEAD stands against origin's branch, which bin/release wants HEAD on:
# as origin serves it now, or offline as it was last fetched. Nothing is
# fetched.
plural() { [ "$1" -eq 1 ] && echo "$1 commit" || echo "$1 commits"; }
if [ -n "${branch:-}" ] && [ "$branch" != HEAD ]; then
    if [ "$offline" -eq 1 ]; then
        remote_head=$(git -C "$root" rev-parse -q --verify "refs/remotes/origin/$branch" 2>/dev/null)
        when=" (as last fetched)"
    else
        remote_head=$(git -C "$root" ls-remote origin "refs/heads/$branch" 2>/dev/null | cut -f1)
        when=""
    fi
    if [ -z "$remote_head" ]; then
        na "origin/$branch not found$when"
    elif ! git -C "$root" cat-file -e "$remote_head^{commit}" 2>/dev/null; then
        na "origin/$branch is at ${remote_head:0:10}, a commit not fetched here"
    else
        ahead=$(git -C "$root" rev-list --count "$remote_head..HEAD")
        behind=$(git -C "$root" rev-list --count "HEAD..$remote_head")
        if [ "$ahead" -gt 0 ]; then
            ko "HEAD is $(plural "$ahead") ahead of origin/$branch$when: bin/release wants it pushed"
        elif [ "$behind" -eq 0 ]; then
            ok "HEAD is on origin/$branch$when"
        fi
        [ "$behind" -eq 0 ] || na "origin/$branch is $(plural "$behind") ahead of HEAD$when"
    fi
fi

if [ "$offline" -eq 1 ]; then
    echo
    echo "Packages"
    for repository in $repositories; do na "php-regex/$repository"; done
    exit 0
fi

if ! command -v gh >/dev/null 2>&1; then
    echo
    ko "gh is not installed: run with --offline, or install the GitHub CLI"
    exit 1
fi

# The checks run on the pull request a commit came from: a merge commit
# answers for the head of its pull request.
head=$(git -C "$root" rev-parse HEAD)
short=$(git -C "$root" rev-parse --short HEAD)
merged=$(git -C "$root" rev-parse -q --verify HEAD^2 2>/dev/null || true)
for workflow in tests.yml engines.yml static-analysis.yml packages.yml coverage.yml benchmarks.yml workflows.yml spelling.yml backward-compatibility.yml demo.yml; do
    ci=""
    for sha in $head $merged; do
        ci=$(gh run list --commit "$sha" --workflow "$workflow" --json conclusion,status --jq '.[0] // empty | "\(.status) \(.conclusion)"' 2>/dev/null)
        [ -z "$ci" ] || break
    done
    case "$ci" in
        "completed success") ok "$workflow passed on $short" ;;
        "") ko "no $workflow run on $short" ;;
        *) ko "$workflow on $short: $ci" ;;
    esac
done

echo
echo "Monorepo"
if gh api repos/php-regex/php-regex --jq .full_name >/dev/null 2>&1; then
    ok "github.com/php-regex/php-regex exists"
    if gh variable list -R php-regex/php-regex 2>/dev/null | grep -qE '^SPLIT_ENABLED[[:space:]]+true'; then ok "SPLIT_ENABLED is true"; else ko "SPLIT_ENABLED is not true: the split workflow is off"; fi
    if gh secret list -R php-regex/php-regex 2>/dev/null | grep -q '^SPLIT_TOKEN'; then ok "SPLIT_TOKEN is set"; else ko "SPLIT_TOKEN is not set (or not readable with this token)"; fi
else
    ko "github.com/php-regex/php-regex does not exist yet: rename php-regex/regex-parser"
fi
source_url=$(curl -sf https://packagist.org/packages/yoeunes/regex-parser.json 2>/dev/null | php -r '$d = json_decode(stream_get_contents(STDIN), true); echo $d["package"]["repository"] ?? "";')
# yoeunes/regex-parser is the 1.x package: reading the monorepo, it would
# publish every v2 tag as a stable version of its own.
case "$source_url" in
    *php-regex/php-regex*) ko "yoeunes/regex-parser on Packagist reads php-regex/php-regex: a v2 tag would release it as 2.x; point it at a repository holding 1.x only" ;;
    "") na "yoeunes/regex-parser: Packagist did not answer" ;;
    *) ok "yoeunes/regex-parser on Packagist reads $source_url" ;;
esac

echo
echo "Packages"
# What Packagist serves for one package on one channel: "<count><tab><latest>",
# empty when Packagist does not answer at all — a package page that answers
# 200 with no versions, and a dev version the stable page never lists, are
# both read as what they are.
packagist_channel() { # <package> <url>
    curl -sf "$2" 2>/dev/null | php -r '$d = json_decode(stream_get_contents(STDIN), true) ?: [];
        $versions = ($d["packages"] ?? [])[$argv[1]] ?? [];
        echo count($versions), "\t", $versions[0]["version"] ?? "";' "$1" 2>/dev/null
}
for repository in $repositories; do
    github="✗ repository"
    # Until the rename, php-regex/regex-parser is the monorepo itself; after
    # it, GitHub redirects the old name to the monorepo until it is reused.
    actual=$(gh api "repos/php-regex/$repository" --jq .full_name 2>/dev/null)
    if [ -n "$actual" ] && [ "$actual" != "php-regex/$repository" ]; then
        github="· redirects to $actual"
    elif gh api "repos/php-regex/$repository/contents/bin/split?ref=2.x" --jq .name >/dev/null 2>&1; then
        github="✗ still the monorepo"
    elif pushed=$(gh api "repos/php-regex/$repository/branches/2.x" --jq '.commit.sha[0:8]' 2>/dev/null); then
        github="✓ 2.x at $pushed"
    elif gh api "repos/php-regex/$repository" --jq .name >/dev/null 2>&1; then
        github="· repository, no 2.x yet"
    fi
    stable=$(packagist_channel "php-regex/$repository" "https://repo.packagist.org/p2/php-regex/$repository.json")
    dev=$(packagist_channel "php-regex/$repository" "https://repo.packagist.org/p2/php-regex/$repository~dev.json")
    stable_count=${stable%%$'\t'*}
    dev_count=${dev%%$'\t'*}
    if [ -n "$stable$dev" ]; then
        if [ "${stable_count:-0}" -gt 0 ] 2>/dev/null; then
            packagist="✓ Packagist ${stable#*$'\t'}"
            if [ "${dev_count:-0}" -gt 0 ] 2>/dev/null; then packagist="$packagist, ${dev#*$'\t'}"; fi
        elif [ "${dev_count:-0}" -gt 0 ] 2>/dev/null; then
            packagist="✗ Packagist: ${dev#*$'\t'} only, no stable yet"
        else
            packagist="✗ Packagist: registered, no versions"
        fi
    else
        packagist="✗ Packagist"
    fi
    printf '  %-34s %-38s %s\n' "php-regex/$repository" "$github" "$packagist"
done
