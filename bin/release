#!/usr/bin/env bash
#
# This file is part of the PHPRegex package.
#
# (c) Younes ENNAJI <younes.ennaji.pro@gmail.com>
#
# For the full copyright and license information, please view the LICENSE
# file that was distributed with this source code.
#
# Releases a version: checks the tree is ready, drafts the GitHub release and
# tags the monorepo. The tag starts two workflows: the phar workflow builds
# regex.phar, attests its build provenance, attaches it and its checksum to
# the draft and publishes the release; the split workflow pushes the tag to
# every php-regex/regex-* repository.
#
# Usage:
#   bin/release [--dry-run] [--skip-ci] [--branch <name>] [--root <dir>] <version>
#
#   --dry-run    run every check, say what would happen, tag nothing
#   --skip-ci    do not ask GitHub whether CI passed on HEAD
#   --branch     the branch to release from (default: 2.x)
#   --root       the monorepo checkout to release (default: the one holding this script)
#
# Run bin/bump <version> first, and commit what it changed.
set -euo pipefail

dry_run=0
skip_ci=0
branch=2.x
root="$(cd "$(dirname "$0")/.." && pwd)"
version=""
while [ $# -gt 0 ]; do
    case "$1" in
        -n|--dry-run) dry_run=1 ;;
        --skip-ci) skip_ci=1 ;;
        --branch) branch=${2:?--branch needs a name}; shift ;;
        --root) root=${2:?--root needs a directory}; shift ;;
        -h|--help) sed -n '10,/^set -/p' "$0" | sed '$d' | sed 's/^# \{0,1\}//'; exit 0 ;;
        -*) echo "Unknown option: $1" >&2; exit 2 ;;
        *) version=$1 ;;
    esac
    shift
done

if ! printf '%s' "$version" | grep -qE '^[0-9]+\.[0-9]+\.[0-9]+(-(BETA|RC)[0-9]+)?$'; then
    echo "\"$version\" is not a version: use 2.1.0, 2.1.0-BETA1 or 2.1.0-RC1." >&2
    exit 2
fi
tag="v$version"
pre_release=0
printf '%s' "$version" | grep -q -- '-' && pre_release=1

cd "$root"
problems=()

# The tree: on the release branch, clean, and not already released.
current_branch=$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo "")
[ "$current_branch" = "$branch" ] || problems+=("HEAD is on \"$current_branch\", not \"$branch\".")
[ -z "$(git status --porcelain 2>/dev/null)" ] || problems+=("The working tree is not clean: commit or remove the changes first.")
git rev-parse -q --verify "refs/tags/$tag" >/dev/null && problems+=("The tag $tag already exists.")

# The commit to release is on origin: the tag would otherwise push commits
# CI never ran on along with it. origin is read as it stands now.
if git fetch -q --no-tags origin "+refs/heads/$branch:refs/remotes/origin/$branch" 2>/dev/null; then
    ahead=$(git rev-list --count "refs/remotes/origin/$branch..HEAD")
    [ "$ahead" -eq 0 ] || problems+=("HEAD is $ahead commit$([ "$ahead" -eq 1 ] || echo s) ahead of origin/$branch: push $branch first.")
else
    problems+=("Git cannot read $branch from origin, so whether origin holds HEAD is unknown.")
fi

# The version the code reports, and the CHANGELOG section of a final release.
current=$(sed -nE "s/.*public const VERSION = '([^']+)';.*/\1/p" src/Toolkit/Regex.php)
[ "$current" = "$version" ] || problems+=("Regex::VERSION is \"$current\", not \"$version\": run bin/bump $version and commit.")
if [ "$pre_release" -eq 0 ] && ! grep -qE "^## \[$version\] - [0-9]{4}-[0-9]{2}-[0-9]{2}$" CHANGELOG.md; then
    problems+=("CHANGELOG.md has no dated \"## [$version]\" section: run bin/bump $version and commit.")
fi

# CI on the commit to release.
if [ "$skip_ci" -eq 0 ]; then
    head=$(git rev-parse HEAD)
    if ! command -v gh >/dev/null 2>&1; then
        problems+=("gh is not installed: it checks CI and publishes the release (or pass --skip-ci).")
    else
        # The workflows that gate a release, each run on every push to the
        # branch; the experimental and scheduled ones do not. demo.yml
        # installs HEAD itself into a Symfony and a Laravel application.
        for workflow in tests.yml engines.yml static-analysis.yml packages.yml coverage.yml benchmarks.yml workflows.yml demo.yml; do
            conclusion=$(gh run list --commit "$head" --workflow "$workflow" --json conclusion --jq '.[0].conclusion' 2>/dev/null || echo "")
            [ "$conclusion" = "success" ] || problems+=("$workflow on $(git rev-parse --short HEAD) is \"${conclusion:-not found}\", not \"success\".")
        done
    fi
fi

if [ "${#problems[@]}" -gt 0 ]; then
    echo "Not ready to release $version:" >&2
    for problem in "${problems[@]}"; do echo "  - $problem" >&2; done
    exit 1
fi

# The release notes: the CHANGELOG section of a final release, or, when
# that section is longer than the 125,000 characters GitHub takes, its
# opening words and a link to the whole of it.
notes=$(mktemp)
trap 'rm -f "$notes"' EXIT
blob="https://github.com/php-regex/php-regex/blob/$tag"
notes_kind="the CHANGELOG section"
if [ "$pre_release" -eq 0 ]; then
    awk -v v="$version" '$0 ~ "^## \\[" v "\\]" { on = 1; next } on && /^## \[/ { exit } on { print }' CHANGELOG.md > "$notes"
    length=$(php -r 'echo mb_strlen(stream_get_contents(STDIN), "UTF-8");' < "$notes")
    if [ "$length" -gt 125000 ]; then
        notes_kind="a summary linking CHANGELOG.md (its section is $length characters, past the 125,000 GitHub takes)"
        opening=$(awk '/^### / { exit } { print }' "$notes" | sed -e '/./,$!d')
        {
            [ -n "$opening" ] && printf '%s\n\n' "$opening"
            printf 'Every change is listed in [CHANGELOG.md](%s/CHANGELOG.md).\n' "$blob"
        } > "$notes"
    fi
else
    printf 'Pre-release of %s. See [CHANGELOG.md](%s/CHANGELOG.md) and [UPGRADE-2.0.md](%s/UPGRADE-2.0.md).\n' "${version%%-*}" "$blob" "$blob" > "$notes"
fi

if [ "$dry_run" -eq 1 ]; then
    echo "Ready to release $version."
    echo "  would create the GitHub release $tag as a draft$([ "$pre_release" -eq 1 ] && echo ' pre-release')"
    echo "  would tag $tag on $(git rev-parse --short HEAD) and push it: the split workflow tags every package, and phar.yml builds and attests regex.phar, attaches it and its checksum, then publishes the draft"
    echo "  release notes: $notes_kind"
    [ "$notes_kind" = "the CHANGELOG section" ] || sed 's/^/    /' "$notes"
    exit 0
fi

# The release is created as a draft first: GitHub refuses it before anything
# is tagged, and a tag pushed cannot be taken back. It stays a draft until
# the phar workflow has attached the phar, so the latest release always
# carries one.
flags=(--title "PHPRegex $version" --notes-file "$notes" --draft --target "$(git rev-parse HEAD)")
[ "$pre_release" -eq 1 ] && flags+=(--prerelease)
gh release create "$tag" "${flags[@]}"

git tag -a "$tag" -m "PHPRegex $version"
git push origin "$tag"

echo "Tagged $version. phar.yml now builds and attests regex.phar, attaches it and publishes the release:"
echo "  gh run watch \$(gh run list --workflow phar.yml --branch $tag --limit 1 --json databaseId --jq '.[0].databaseId')"
echo "Then: bin/bump --next <version>, and check bin/status once the split has run."
