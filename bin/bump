#!/usr/bin/env bash
#
# This file is part of the PHPRegex package.
#
# (c) Younes ENNAJI <younes.ennaji.pro@gmail.com>
#
# For the full copyright and license information, please view the LICENSE
# file that was distributed with this source code.
#
# Sets the version every package reports, before a release or after one.
#
# Usage:
#   bin/bump [--dry-run] [--root <dir>] [--date YYYY-MM-DD] <version>
#   bin/bump [--dry-run] [--root <dir>] --next <version>
#
#   <version>   2.1.0, 2.1.0-BETA1, 2.1.0-RC1: sets Regex::VERSION and VERSION_ID,
#               and for a final version dates the CHANGELOG's Unreleased section
#               and names it after <version>. The sample outputs of the docs
#               that report the current pre-release version report <version>.
#               The first final version also moves the install story from the
#               dev channel to the release: docs/_data/product.yml says
#               "stable: true" (the pages read it), and README.md and
#               docs/llms.txt lose the two "composer config" lines, the
#               ":2.x-dev" suffix and the "is coming" section.
#   --next      after a release: sets Regex::VERSION to <version>-DEV and opens
#               a "## [<version>] - Unreleased" section in the CHANGELOG
#   --date      the release date written in the CHANGELOG (default: today)
#   --dry-run   say what would change, change nothing
#   --root      the monorepo checkout to change (default: the one holding this script)
#
# The packages' composer.json files carry no version: Composer reads it from
# the tag.
set -euo pipefail

dry_run=0
next=0
date=$(date +%Y-%m-%d)
root="$(cd "$(dirname "$0")/.." && pwd)"
version=""
while [ $# -gt 0 ]; do
    case "$1" in
        -n|--dry-run) dry_run=1 ;;
        --next) next=1 ;;
        --date) date=${2:?--date needs YYYY-MM-DD}; shift ;;
        --root) root=${2:?--root needs a directory}; shift ;;
        -h|--help) sed -n '10,/^set -/p' "$0" | sed '$d' | sed 's/^# \{0,1\}//'; exit 0 ;;
        -*) echo "Unknown option: $1" >&2; exit 2 ;;
        *) version=$1 ;;
    esac
    shift
done

if ! printf '%s' "$version" | grep -qE '^[0-9]+\.[0-9]+\.[0-9]+(-(BETA|RC)[0-9]+)?$'; then
    echo "\"$version\" is not a version: use 2.1.0, 2.1.0-BETA1 or 2.1.0-RC1." >&2
    exit 2
fi
if [ "$next" -eq 1 ] && printf '%s' "$version" | grep -q -- '-'; then
    echo "--next takes the next final version, as 2.1.1." >&2
    exit 2
fi
printf '%s' "$date" | grep -qE '^[0-9]{4}-[0-9]{2}-[0-9]{2}$' || { echo "\"$date\" is not a date: use YYYY-MM-DD." >&2; exit 2; }

regex="$root/src/Toolkit/Regex.php"
changelog="$root/CHANGELOG.md"
current=$(sed -nE "s/.*public const VERSION = '([^']+)';.*/\1/p" "$regex")
[ -z "$current" ] && { echo "No VERSION constant in src/Toolkit/Regex.php." >&2; exit 1; }

target=$version
[ "$next" -eq 1 ] && target="$version-DEV"

# PHP orders DEV < BETA < RC < final, as Composer does.
if [ "$(php -r 'echo version_compare($argv[1], $argv[2]);' "$target" "$current")" != "1" ]; then
    echo "$target does not come after the current version, $current." >&2
    exit 1
fi

echo "$current -> $target"

new_changelog=""
if [ "$next" -eq 1 ]; then
    if grep -qE '^## \[[^]]+\] - Unreleased$' "$changelog"; then
        echo "CHANGELOG.md already has an Unreleased section: left as it is"
    else
        new_changelog=$(awk -v v="$version" 'done == 0 && /^## \[/ { print "## [" v "] - Unreleased\n"; done = 1 } { print }' "$changelog")
        echo "CHANGELOG.md: opens ## [$version] - Unreleased"
    fi
elif printf '%s' "$version" | grep -q -- '-'; then
    echo "CHANGELOG.md: unchanged for a pre-release"
else
    if ! grep -qE '^## \[[^]]+\] - Unreleased$' "$changelog"; then
        echo "CHANGELOG.md has no Unreleased section to release as $version." >&2
        exit 1
    fi
    new_changelog=$(awk -v v="$version" -v d="$date" 'done == 0 && /^## \[[^]]+\] - Unreleased$/ { print "## [" v "] - " d; done = 1; next } { print }' "$changelog")
    echo "CHANGELOG.md: ## [$version] - $date"
fi
# VERSION_ID is the version as an integer, 2.1.3 as 20103, as PHP_VERSION_ID.
base=${version%%-*}
IFS=. read -r major minor patch <<< "$base"
version_id=$((major * 10000 + minor * 100 + patch))
echo "src/Toolkit/Regex.php: VERSION = '$target', VERSION_ID = $version_id"

# The install story: docs/_data/product.yml says whether a stable release
# exists, and the pages read it. The first final version flips it, and
# rewrites the two files Jekyll does not render, README.md and docs/llms.txt.
product="$root/docs/_data/product.yml"
readme="$root/README.md"
llms="$root/docs/llms.txt"
[ -f "$product" ] || { echo "No docs/_data/product.yml: it says whether a stable release exists." >&2; exit 1; }
stable=$(sed -nE 's/^stable: (true|false)$/\1/p' "$product")
[ -n "$stable" ] || { echo "docs/_data/product.yml has no \"stable: true|false\" line: it says whether a stable release exists." >&2; exit 1; }
release=$(sed -nE 's/^release: (.+)$/\1/p' "$product")
release_pattern=$(printf '%s' "$release" | sed 's/[.[\*^$]/\\&/g')
final=0
if [ "$next" -eq 0 ] && ! printf '%s' "$version" | grep -q -- '-'; then final=1; fi
switch=0
if [ "$final" -eq 1 ] && [ "$stable" = "false" ]; then switch=1; fi

if [ "$final" -eq 1 ]; then
    if [ "$switch" -eq 1 ]; then
        echo "docs/_data/product.yml: stable: true, version_label: $version"
        for file in "$readme" "$llms"; do
            [ -f "$file" ] || continue
            relative=${file#"$root/"}
            if grep -qE '^## .* is coming$' "$file"; then
                echo "$relative: the \"is coming\" section and the dev channel removed"
            elif grep -qE "composer config (minimum-stability dev|prefer-stable true)|:${release_pattern}-dev" "$file"; then
                echo "$relative: the dev channel removed"
            fi
        done
    else
        echo "docs/_data/product.yml: version_label: $version"
    fi
fi

# The sample outputs: a pre-release version the docs report, "PHPRegex
# 2.1.0-DEV", reports the version the tree moves to. A released version
# stays: it is what the published phar prints.
samples=()
if [ "$next" -eq 0 ] && printf '%s' "$current" | grep -q -- '-' && [ -d "$root/docs" ]; then
    while IFS= read -r file; do
        [ -n "$file" ] && samples+=("$file")
    done < <(grep -rlF --include='*.md' --exclude-dir=_site -- "$current" "$root/docs" | LC_ALL=C sort)
    for file in ${samples[@]+"${samples[@]}"}; do
        echo "${file#"$root/"}: $current -> $target"
    done
fi

if [ "$dry_run" -eq 1 ]; then
    echo "(dry run: nothing written)"
    exit 0
fi

# Write a file through a temporary copy, so that a failing sed leaves it whole.
rewrite() { # <file> <sed arguments...>
    local file=$1 tmp
    shift
    tmp=$(mktemp)
    sed "$@" "$file" > "$tmp" && cat "$tmp" > "$file"
    rm -f "$tmp"
}

rewrite "$regex" -E -e "s/(public const VERSION = ')[^']+(';)/\1$target\2/" -e "s/(public const VERSION_ID = )[0-9]+;/\1$version_id;/"
if [ -n "$new_changelog" ]; then
    printf '%s\n' "$new_changelog" > "$changelog"
fi
if [ "$final" -eq 1 ]; then
    rewrite "$product" -E -e "s/^version_label: .*$/version_label: $version/"
fi
if [ "$switch" -eq 1 ]; then
    rewrite "$product" -E -e 's/^stable: false$/stable: true/'
    for file in "$readme" "$llms"; do
        [ -f "$file" ] || continue
        if grep -qE '^## .* is coming$' "$file"; then
            tmp=$(mktemp)
            awk 'skip && /^## / { skip = 0 } /^## .* is coming$/ { skip = 1 } !skip { print }' "$file" > "$tmp" && cat "$tmp" > "$file"
            rm -f "$tmp"
        fi
        rewrite "$file" -E -e '/^composer config (minimum-stability dev|prefer-stable true)$/d' -e "s/:${release_pattern}-dev//g"
    done
fi
for file in ${samples[@]+"${samples[@]}"}; do
    rewrite "$file" -e "s/$(printf '%s' "$current" | sed 's/[.[\*^$/]/\\&/g')/$target/g"
done
