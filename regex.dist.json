{
    "$schema": "./src/Linter/regex.schema.json",
    "paths": [
        "src"
    ],
    "exclude": [
        "vendor",
        "tests",
        "Tests",
        "Fixtures"
    ],
    "extraction": {
        "interop": [
            "composer-pcre",
            "nette-utils",
            "spatie-regex",
            "illuminate-support"
        ],
        "functions": [
            "PhpCsFixer\\Preg::match",
            "PhpCsFixer\\Preg::matchAll",
            "PhpCsFixer\\Preg::replace",
            "PhpCsFixer\\Preg::replaceCallback",
            "PhpCsFixer\\Preg::split",
            "Symplify\\CodingStandard\\Utils\\Regex::replace#1",
            "Symplify\\CodingStandard\\Utils\\Regex::match#1",
            "Dotenv\\Util\\Regex::matches",
            "Dotenv\\Util\\Regex::occurrences",
            "Dotenv\\Util\\Regex::split",
            "Dotenv\\Util\\Regex::replaceCallback",
            "Tempest\\Support\\Regex\\replace#1",
            "Tempest\\Support\\Regex\\matches#1"
        ]
    },
    "checks": {
        "validation": true,
        "redos": {
            "enabled": false,
            "mode": "confirmed",
            "threshold": "critical"
        },
        "optimizations": {
            "enabled": true,
            "options": {
                "digits": false,
                "word": false,
                "ranges": false,
                "canonicalizeCharClasses": false,
                "possessive": false,
                "factorize": false,
                "minQuantifierCount": 4,
                "verifyWithAutomata": true
            }
        },
        "lint": {
            "enabled": true,
            "rules": {
                "unicode.shorthandWithoutU": false
            }
        }
    }
}
