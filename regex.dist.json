{
    "$schema": "./src/Linter/regex.schema.json",
    "paths": [
        "src"
    ],
    "exclude": [
        "vendor",
        "tests",
        "Tests",
        "Fixtures"
    ],
    "extraction": {
        "interop": [
            "composer-pcre",
            "nette-utils",
            "spatie-regex",
            "laravel-str"
        ],
        "functions": []
    },
    "checks": {
        "validation": true,
        "redos": {
            "enabled": false,
            "mode": "confirmed",
            "threshold": "critical"
        },
        "optimizations": {
            "enabled": true,
            "options": {
                "digits": false,
                "word": false,
                "ranges": false,
                "canonicalizeCharClasses": false,
                "possessive": false,
                "factorize": false,
                "minQuantifierCount": 4,
                "verifyWithAutomata": true
            }
        },
        "lint": {
            "enabled": true,
            "rules": {
                "unicode.shorthandWithoutU": false
            }
        }
    }
}
