#!/usr/bin/env php
<?php

declare(strict_types=1);

/**
 * Corpus Update Script
 *
 * Updates git repositories under corpus/ with parallel processing and timeouts,
 * records the commit each checkout sits on in corpus/corpus.json, and removes
 * the checkouts whose entry was deleted from the manifest.
 */

final class ConsoleStyle
{
    private bool $useColor;

    public function __construct()
    {
        $this->useColor = $this->supportsColor();
    }

    public function header(string $title): void
    {
        $line = str_repeat('=', \strlen($title));
        echo $this->bold($title).PHP_EOL;
        echo $this->dim($line).PHP_EOL;
    }

    public function status(string $label, string $message, ?string $detail = null): void
    {
        $plainLabel = preg_replace('/\e\[[\d;]*m/', '', $label);
        $plainLabel ??= $label;
        $pad = max(0, 9 - \strlen($plainLabel));
        $label = $label.str_repeat(' ', $pad);
        echo '  '.$label.' '.$message.PHP_EOL;
        if (null !== $detail && '' !== $detail) {
            echo $this->indent($detail, '            ');
        }
    }

    public function info(string $message): void
    {
        echo $message.PHP_EOL;
    }

    public function warn(string $message): void
    {
        echo $this->yellow('Warning: ').$message.PHP_EOL;
    }

    public function error(string $message): void
    {
        fwrite(\STDERR, $this->red('Error: ').$message.PHP_EOL);
    }

    public function dim(string $text): string
    {
        return $this->colorize($text, '2');
    }

    public function bold(string $text): string
    {
        return $this->colorize($text, '1');
    }

    public function green(string $text): string
    {
        return $this->colorize($text, '32');
    }

    public function red(string $text): string
    {
        return $this->colorize($text, '31');
    }

    public function yellow(string $text): string
    {
        return $this->colorize($text, '33');
    }

    public function cyan(string $text): string
    {
        return $this->colorize($text, '36');
    }

    private function colorize(string $text, string $code): string
    {
        if (!$this->useColor) {
            return $text;
        }

        return "\033[".$code."m".$text."\033[0m";
    }

    private function supportsColor(): bool
    {
        if ('1' === getenv('NO_COLOR')) {
            return false;
        }

        if (!\function_exists('posix_isatty')) {
            return false;
        }

        return posix_isatty(\STDOUT);
    }

    private function indent(string $text, string $prefix): string
    {
        $lines = preg_split("/\\r?\\n/", trim($text));
        if (!\is_array($lines)) {
            return '';
        }

        $indented = array_map(static fn (string $line): string => $prefix.$line, $lines);

        return implode(PHP_EOL, $indented).PHP_EOL;
    }
}

// ---------------------------------------------------------------------------
// Argument parsing
// ---------------------------------------------------------------------------

/**
 * @return array<string, mixed>
 */
function parseArgs(array $argv): array
{
    $options = [
        'jobs' => null,
        'timeout' => null,
        'force' => false,
        'debug' => false,
        'help' => false,
        'clone' => true,
        'clone-only' => false,
        'prune' => true,
        'write-manifest' => false,
        'add' => [],
        'as' => null,
        'branch' => null,
        'depth' => null,
    ];

    for ($i = 1; $i < \count($argv); $i++) {
        $arg = $argv[$i];
        if ('--help' === $arg || '-h' === $arg) {
            $options['help'] = true;
            continue;
        }
        if ('--force' === $arg) {
            $options['force'] = true;
            continue;
        }
        if ('--debug' === $arg) {
            $options['debug'] = true;
            continue;
        }
        if ('--no-clone' === $arg) {
            $options['clone'] = false;
            continue;
        }
        if ('--no-prune' === $arg) {
            $options['prune'] = false;
            continue;
        }
        if ('--clone-only' === $arg) {
            $options['clone-only'] = true;
            continue;
        }
        if ('--write-manifest' === $arg) {
            $options['write-manifest'] = true;
            continue;
        }
        if ('--add' === $arg) {
            $next = $argv[$i + 1] ?? null;
            if (null === $next || str_starts_with($next, '-')) {
                throw new InvalidArgumentException('The --add option requires a repository URL.');
            }
            $options['add'][] = $next;
            $i++;
            continue;
        }
        if (str_starts_with($arg, '--add=')) {
            $options['add'][] = substr($arg, \strlen('--add='));
            continue;
        }
        foreach (['as', 'branch', 'depth'] as $name) {
            if ('--'.$name === $arg) {
                $next = $argv[$i + 1] ?? null;
                if (null === $next || str_starts_with($next, '-')) {
                    throw new InvalidArgumentException(sprintf('The --%s option requires a value.', $name));
                }
                $options[$name] = $next;
                $i++;
                continue 2;
            }
            if (str_starts_with($arg, '--'.$name.'=')) {
                $options[$name] = substr($arg, \strlen('--'.$name.'='));
                continue 2;
            }
        }
        if ('--jobs' === $arg || '-j' === $arg) {
            $next = $argv[$i + 1] ?? null;
            if (null === $next || str_starts_with($next, '-')) {
                $options['jobs'] = null;
                continue;
            }
            $options['jobs'] = $next;
            $i++;
            continue;
        }
        if (str_starts_with($arg, '--jobs=')) {
            $options['jobs'] = substr($arg, \strlen('--jobs='));
            continue;
        }
        if ('--timeout' === $arg || '-t' === $arg) {
            $next = $argv[$i + 1] ?? null;
            if (null === $next || str_starts_with($next, '-')) {
                continue;
            }
            $options['timeout'] = $next;
            $i++;
            continue;
        }
        if (str_starts_with($arg, '--timeout=')) {
            $options['timeout'] = substr($arg, \strlen('--timeout='));
            continue;
        }

        throw new InvalidArgumentException(sprintf('Unknown argument: %s', $arg));
    }

    return $options;
}

function printUsage(): void
{
    echo <<<'TXT'
Usage: corpus/update [--jobs[=<n>|auto]] [--timeout=<sec>] [--force] [--debug] [--help]
       corpus/update --add <url> [--as <path>] [--branch <name>] [--depth <n>]
       corpus/update --write-manifest

Removes the checkouts whose entry is no longer in corpus/corpus.json, clones
every listed repository that is missing on disk, then updates the ones that
are already there, switching each to the branch recorded in the manifest
before pulling. The commit each checkout ends on is written back to the
manifest, so the output shows which repositories moved since the last run.

Options:
  --jobs, -j        Number of parallel workers (default: auto, 2x CPUs)
  --timeout, -t     Per-repo timeout in seconds (default: 120)
  --force           Reset tracked changes and remove untracked files before pulling,
                    and remove unlisted checkouts even when they have local changes
  --debug           Show git commands and detailed diagnostics per repo
  --no-clone        Do not clone missing repositories, only pull existing ones
  --clone-only      Only clone missing repositories, do not pull existing ones
  --no-prune        Keep checkouts on disk that are no longer in the manifest
  --add <url>       Add a repository to the manifest and clone it (repeatable)
  --as <path>       Target path under corpus/ for --add (default: derived from the URL)
  --branch <name>   Branch to record for --add (default: the remote default branch)
  --depth <n>       Clone depth for --add, 0 for a full clone (default: manifest default)
  --write-manifest  Rewrite corpus/corpus.json from the repositories found on disk
  --help, -h        Show this help message

TXT;
}

// ---------------------------------------------------------------------------
// System helpers
// ---------------------------------------------------------------------------

function detectCpuCount(): int
{
    if (\function_exists('swoole_cpu_num')) {
        return swoole_cpu_num();
    }

    if (\DIRECTORY_SEPARATOR === '/') {
        if (\is_readable('/proc/cpuinfo')) {
            $cpuinfo = \file_get_contents('/proc/cpuinfo');
            if (false !== $cpuinfo) {
                $matches = [];
                \preg_match_all('/^processor\\s*:/m', $cpuinfo, $matches);
                if (!empty($matches[0])) {
                    return \count($matches[0]);
                }
            }
        }

        $result = \shell_exec('sysctl -n hw.ncpu 2>/dev/null');
        if (null !== $result) {
            $cpu = (int) trim((string) $result);
            if ($cpu > 0) {
                return $cpu;
            }
        }
    } else {
        $result = \shell_exec('wmic cpu get NumberOfCores 2>nul | findstr /r /v "^$" | findstr /v "NumberOfCores"');
        if (null !== $result) {
            $cpu = (int) trim((string) $result);
            if ($cpu > 0) {
                return $cpu;
            }
        }
    }

    return 1;
}

function supportsParallel(): bool
{
    return \PHP_SAPI === 'cli'
        && \function_exists('pcntl_fork')
        && \function_exists('pcntl_waitpid');
}

// ---------------------------------------------------------------------------
// Repository discovery
// ---------------------------------------------------------------------------

/**
 * @return array<string>
 */
function findGitRepos(string $dir): array
{
    $repos = [];
    findGitReposRecursive($dir, $repos);

    sort($repos);

    return $repos;
}

/**
 * @param array<string> $repos
 */
function findGitReposRecursive(string $dir, array &$repos): void
{
    $subdirs = glob($dir.'/*', GLOB_ONLYDIR);
    if (false === $subdirs) {
        return;
    }

    foreach ($subdirs as $subdir) {
        if (is_dir($subdir.'/.git')) {
            $repos[] = $subdir;
            continue;
        }

        if ('.' === basename($subdir)[0]) {
            continue;
        }

        findGitReposRecursive($subdir, $repos);
    }
}

function isSafeRepo(string $repoPath, string $corpusDir): bool
{
    $repoReal = realpath($repoPath);
    $corpusReal = realpath($corpusDir);
    if (false === $repoReal || false === $corpusReal) {
        return false;
    }

    $prefix = rtrim($corpusReal, DIRECTORY_SEPARATOR).DIRECTORY_SEPARATOR;

    return str_starts_with($repoReal, $prefix) && is_dir($repoReal.'/.git');
}

function formatRepoLabel(string $repoPath, string $corpusDir): string
{
    $repoReal = realpath($repoPath) ?: $repoPath;
    $corpusReal = realpath($corpusDir) ?: $corpusDir;
    $prefix = rtrim($corpusReal, DIRECTORY_SEPARATOR).DIRECTORY_SEPARATOR;

    if (str_starts_with($repoReal, $prefix)) {
        return substr($repoReal, \strlen($prefix));
    }

    return $repoReal;
}

// ---------------------------------------------------------------------------
// Manifest (corpus/corpus.json)
// ---------------------------------------------------------------------------

const MANIFEST_DEFAULTS = ['remote' => 'origin', 'depth' => 1, 'protocol' => 'https'];

const MANIFEST_PROTOCOLS = ['https', 'ssh', 'preserve'];

function manifestPath(string $corpusDir): string
{
    return $corpusDir.\DIRECTORY_SEPARATOR.'corpus.json';
}

/**
 * A manifest entry is either a URL string or an object with url/branch/depth,
 * plus the commit the checkout was on at the last run (written by this script).
 *
 * @return array{defaults: array{remote: string, depth: int}, repositories: array<string, array{url: string, branch: ?string, depth: int, commit: ?string}>}
 */
function loadManifest(string $path): array
{
    if (!is_file($path)) {
        return ['defaults' => MANIFEST_DEFAULTS, 'repositories' => []];
    }

    $raw = file_get_contents($path);
    if (false === $raw) {
        throw new RuntimeException(sprintf('Unable to read %s.', $path));
    }

    try {
        $data = json_decode($raw, true, 32, \JSON_THROW_ON_ERROR);
    } catch (JsonException $e) {
        throw new RuntimeException(sprintf('Invalid JSON in %s: %s', $path, $e->getMessage()));
    }

    if (!\is_array($data)) {
        throw new RuntimeException(sprintf('The manifest %s must contain a JSON object.', $path));
    }

    $defaults = MANIFEST_DEFAULTS;
    if (isset($data['defaults']) && \is_array($data['defaults'])) {
        if (isset($data['defaults']['remote']) && \is_string($data['defaults']['remote'])) {
            $defaults['remote'] = $data['defaults']['remote'];
        }
        if (isset($data['defaults']['depth']) && is_numeric($data['defaults']['depth'])) {
            $defaults['depth'] = max(0, (int) $data['defaults']['depth']);
        }
        if (isset($data['defaults']['protocol']) && \in_array($data['defaults']['protocol'], MANIFEST_PROTOCOLS, true)) {
            $defaults['protocol'] = $data['defaults']['protocol'];
        }
    }

    $repositories = [];
    $entries = $data['repositories'] ?? [];
    if (!\is_array($entries)) {
        throw new RuntimeException(sprintf('The "repositories" key of %s must be an object.', $path));
    }

    foreach ($entries as $relPath => $entry) {
        if (!\is_string($relPath)) {
            throw new RuntimeException('Manifest repository keys must be paths relative to corpus/.');
        }

        $relPath = normalizeManifestPath($relPath);
        $repositories[$relPath] = normalizeManifestEntry($relPath, $entry, $defaults);
    }

    ksort($repositories, \SORT_NATURAL | \SORT_FLAG_CASE);

    return ['defaults' => $defaults, 'repositories' => $repositories];
}

/**
 * @param array{remote: string, depth: int} $defaults
 *
 * @return array{url: string, branch: ?string, depth: int, commit: ?string}
 */
function normalizeManifestEntry(string $relPath, mixed $entry, array $defaults): array
{
    if (\is_string($entry)) {
        $entry = ['url' => $entry];
    }

    if (!\is_array($entry) || !isset($entry['url']) || !\is_string($entry['url'])) {
        throw new RuntimeException(sprintf('Manifest entry "%s" needs a "url" string.', $relPath));
    }

    $url = trim($entry['url']);
    if (!isValidRepoUrl($url)) {
        throw new RuntimeException(sprintf('Manifest entry "%s" has an unsupported URL: %s', $relPath, $url));
    }

    $branch = null;
    if (isset($entry['branch']) && \is_string($entry['branch']) && '' !== trim($entry['branch'])) {
        $branch = trim($entry['branch']);
        if (str_starts_with($branch, '-')) {
            throw new RuntimeException(sprintf('Manifest entry "%s" has an invalid branch: %s', $relPath, $branch));
        }
    }

    $depth = $defaults['depth'];
    if (isset($entry['depth']) && is_numeric($entry['depth'])) {
        $depth = max(0, (int) $entry['depth']);
    }

    $commit = null;
    if (isset($entry['commit'])) {
        if (!\is_string($entry['commit']) || !isCommitHash($entry['commit'])) {
            throw new RuntimeException(sprintf('Manifest entry "%s" has an invalid commit hash.', $relPath));
        }
        $commit = strtolower($entry['commit']);
    }

    return [
        'url' => normalizeCloneUrl($url, $defaults['protocol']),
        'branch' => $branch,
        'depth' => $depth,
        'commit' => $commit,
    ];
}

/**
 * A full SHA-1 or SHA-256 object name, as `git rev-parse HEAD` prints it.
 */
function isCommitHash(string $hash): bool
{
    return 1 === preg_match('/^(?:[0-9a-f]{40}|[0-9a-f]{64})$/i', $hash);
}

function isValidRepoUrl(string $url): bool
{
    return 1 === preg_match('~^(?:https://|ssh://|git://|[\w.-]+@[\w.-]+:)[^\s]+$~', $url);
}

/**
 * Rewrite a clone URL to the protocol requested by the manifest defaults.
 *
 * "preserve" keeps the URL as-is, "https" produces https://host/path and
 * "ssh" produces git@host:path.
 */
function normalizeCloneUrl(string $url, string $protocol): string
{
    if ('preserve' === $protocol) {
        return $url;
    }

    $matches = [];
    if (1 === preg_match('~^(?:https?|ssh|git)://(?:[^@/]+@)?([^/:]+)(?::\d+)?/(.+)$~', $url, $matches)) {
        [, $host, $path] = $matches;
    } elseif (1 === preg_match('~^[\w.-]+@([\w.-]+):(.+)$~', $url, $matches)) {
        [, $host, $path] = $matches;
    } else {
        return $url;
    }

    $path = ltrim($path, '/');

    return 'https' === $protocol ? sprintf('https://%s/%s', $host, $path) : sprintf('git@%s:%s', $host, $path);
}

/**
 * Reject absolute paths, traversal and anything that would escape corpus/.
 */
function normalizeManifestPath(string $relPath): string
{
    $relPath = trim(str_replace('\\', '/', $relPath));
    $relPath = trim($relPath, '/');

    if ('' === $relPath) {
        throw new RuntimeException('Manifest repository paths must not be empty.');
    }

    foreach (explode('/', $relPath) as $segment) {
        if ('' === $segment || '.' === $segment || '..' === $segment) {
            throw new RuntimeException(sprintf('Unsafe manifest repository path: %s', $relPath));
        }
    }

    return $relPath;
}

/**
 * @param array{defaults: array{remote: string, depth: int}, repositories: array<string, array{url: string, branch: ?string, depth: int, commit: ?string}>} $manifest
 */
function encodeManifest(array $manifest): string
{
    $encode = static function (mixed $value): string {
        $json = json_encode($value, \JSON_UNESCAPED_SLASHES | \JSON_UNESCAPED_UNICODE);

        return false === $json ? '""' : $json;
    };

    $lines = [];
    $lines[] = '{';
    $lines[] = '    "defaults": {';
    $lines[] = '        "remote": '.$encode($manifest['defaults']['remote']).',';
    $lines[] = '        "depth": '.$manifest['defaults']['depth'].',';
    $lines[] = '        "protocol": '.$encode($manifest['defaults']['protocol']);
    $lines[] = '    },';
    $lines[] = '    "repositories": {';

    $entries = [];
    foreach ($manifest['repositories'] as $relPath => $entry) {
        $parts = ['"url": '.$encode($entry['url'])];
        if (null !== $entry['branch']) {
            $parts[] = '"branch": '.$encode($entry['branch']);
        }
        if ($entry['depth'] !== $manifest['defaults']['depth']) {
            $parts[] = '"depth": '.$entry['depth'];
        }
        if (null !== $entry['commit']) {
            $parts[] = '"commit": '.$encode($entry['commit']);
        }

        $entries[] = '        '.$encode($relPath).': { '.implode(', ', $parts).' }';
    }

    $lines[] = implode(','.PHP_EOL, $entries);
    $lines[] = '    }';
    $lines[] = '}';

    return implode(PHP_EOL, $lines).PHP_EOL;
}

/**
 * @param array{defaults: array{remote: string, depth: int}, repositories: array<string, array{url: string, branch: ?string, depth: int, commit: ?string}>} $manifest
 */
function saveManifest(string $path, array $manifest): void
{
    ksort($manifest['repositories'], \SORT_NATURAL | \SORT_FLAG_CASE);

    if (false === file_put_contents($path, encodeManifest($manifest))) {
        throw new RuntimeException(sprintf('Unable to write %s.', $path));
    }
}

/**
 * @param array<string>                       $repos
 * @param array{remote: string, depth: int}   $defaults
 *
 * @return array{defaults: array{remote: string, depth: int}, repositories: array<string, array{url: string, branch: ?string, depth: int, commit: ?string}>, skipped: array<string>}
 */
function buildManifestFromDisk(string $corpusDir, array $repos, array $defaults, int $timeout): array
{
    $repositories = [];
    $skipped = [];

    foreach ($repos as $repoPath) {
        $relPath = formatRepoLabel($repoPath, $corpusDir);
        $url = getRemoteUrl($repoPath, $defaults['remote'], $timeout);
        if (null === $url || !isValidRepoUrl($url)) {
            $skipped[] = $relPath;
            continue;
        }

        $repositories[$relPath] = [
            'url' => normalizeCloneUrl($url, $defaults['protocol']),
            'branch' => getCurrentBranch($repoPath, $timeout),
            'depth' => $defaults['depth'],
            'commit' => getHeadCommit($repoPath, $timeout),
        ];
    }

    ksort($repositories, \SORT_NATURAL | \SORT_FLAG_CASE);

    return ['defaults' => $defaults, 'repositories' => $repositories, 'skipped' => $skipped];
}

function getRemoteUrl(string $repoPath, string $remote, int $timeout): ?string
{
    $result = runGit($repoPath, ['remote', 'get-url', $remote], $timeout);
    if (0 !== $result['code']) {
        return null;
    }

    $url = trim($result['output']);

    return '' === $url ? null : $url;
}

/**
 * Derive "vendor/repo" style target paths from a clone URL.
 */
function deriveTargetPath(string $url, array $taken): string
{
    $path = preg_replace('~^(?:https?://|ssh://|git://)[^/]+/~', '', $url) ?? $url;
    $path = preg_replace('~^git@[^:]+:~', '', $path) ?? $path;
    $path = preg_replace('~\.git$~', '', $path) ?? $path;
    $path = trim($path, '/');

    $segments = array_values(array_filter(explode('/', $path), static fn (string $s): bool => '' !== $s));
    if ([] === $segments) {
        throw new RuntimeException(sprintf('Unable to derive a target path from %s.', $url));
    }

    $name = normalizeManifestPath(end($segments));
    if (!isset($taken[$name])) {
        return $name;
    }

    if (\count($segments) >= 2) {
        $nested = normalizeManifestPath($segments[\count($segments) - 2].'/'.$name);
        if (!isset($taken[$nested])) {
            return $nested;
        }
    }

    return $name;
}

/**
 * @param array{url: string, branch: ?string, depth: int, commit: ?string} $entry
 *
 * @return array{path: string, status: string, output: string, command: string, code: int, log: array<string>}
 */
function cloneRepo(string $relPath, array $entry, string $corpusDir, bool $debug, int $timeout): array
{
    $target = $corpusDir.\DIRECTORY_SEPARATOR.$relPath;
    $log = [];

    $result = static fn (string $status, string $output, string $command, int $code): array => [
        'path' => $target,
        'status' => $status,
        'output' => $output,
        'command' => $command,
        'code' => $code,
        'log' => $log,
    ];

    if (is_dir($target.'/.git')) {
        return $result('SKIP', 'Already cloned.', 'N/A', 0);
    }

    if (is_dir($target) && [] !== array_diff((array) (scandir($target) ?: []), ['.', '..'])) {
        return $result('FAIL', 'Target directory exists and is not empty.', 'N/A', 1);
    }

    $parent = \dirname($target);
    if (!is_dir($parent) && !mkdir($parent, 0o775, true) && !is_dir($parent)) {
        return $result('FAIL', sprintf('Unable to create directory %s.', $parent), 'N/A', 1);
    }

    $args = ['clone', '--quiet'];
    if ($entry['depth'] > 0) {
        $args[] = '--depth';
        $args[] = (string) $entry['depth'];
        $args[] = '--single-branch';
    }
    if (null !== $entry['branch']) {
        $args[] = '--branch';
        $args[] = $entry['branch'];
    }
    $args[] = '--';
    $args[] = $entry['url'];
    $args[] = $target;

    $command = 'git '.implode(' ', $args);
    $log[] = $command;

    $clone = runGit($corpusDir, $args, $timeout);
    if (0 !== $clone['code']) {
        return $result('FAIL', $clone['output'], $command, $clone['code']);
    }

    return $result('OK', '', $command, 0) + [
        'change' => 'cloned',
        'commit' => getHeadCommit($target, $timeout),
    ];
}

/**
 * Generic worker pool used for cloning; falls back to sequential execution.
 *
 * @param array<int, mixed> $items
 *
 * @return array<int, array<string, mixed>>
 */
function runJobsParallel(array $items, int $jobs, callable $task, callable $onComplete): array
{
    $results = [];
    $queue = $items;
    /** @var array<int, array{tmp: string, item: mixed}> $active */
    $active = [];
    $completed = 0;
    $total = \count($items);

    while ($queue || $active) {
        while (\count($active) < $jobs && $queue) {
            $item = array_shift($queue);
            $tmp = 1 === $jobs ? false : tempnam(sys_get_temp_dir(), 'corpus_');
            $pid = false === $tmp ? -1 : pcntl_fork();

            if (-1 === $pid) {
                if (false !== $tmp) {
                    @unlink($tmp);
                }
                $results[] = $task($item);
                $completed++;
                $onComplete($completed, $total);
                continue;
            }

            if (0 === $pid) {
                file_put_contents((string) $tmp, serialize($task($item)));
                exit(0);
            }

            $active[$pid] = ['tmp' => (string) $tmp, 'item' => $item];
        }

        if ([] === $active) {
            break;
        }

        $pid = pcntl_waitpid(-1, $status);
        if ($pid > 0 && isset($active[$pid])) {
            $info = $active[$pid];
            unset($active[$pid]);

            $data = @file_get_contents($info['tmp']);
            @unlink($info['tmp']);
            $decoded = false === $data ? false : @unserialize($data);

            $results[] = \is_array($decoded) ? $decoded : [
                'path' => \is_string($info['item']) ? $info['item'] : 'unknown',
                'status' => 'FAIL',
                'output' => 'Worker produced no result.',
                'command' => 'N/A',
                'code' => 1,
                'log' => [],
            ];

            $completed++;
            $onComplete($completed, $total);
        }
    }

    return $results;
}

// ---------------------------------------------------------------------------
// Git execution with timeout
// ---------------------------------------------------------------------------

/**
 * @param array<int, string> $args
 *
 * @return array{code: int, output: string}
 */
function runGit(string $repoPath, array $args, int $timeout = 120): array
{
    $command = array_merge(['git'], $args);
    $descriptors = [
        0 => ['file', '/dev/null', 'r'],
        1 => ['pipe', 'w'],
        2 => ['pipe', 'w'],
    ];

    $process = proc_open($command, $descriptors, $pipes, $repoPath, ['GIT_TERMINAL_PROMPT' => '0']);
    if (!\is_resource($process)) {
        return ['code' => 1, 'output' => 'Failed to start git process.'];
    }

    stream_set_blocking($pipes[1], false);
    stream_set_blocking($pipes[2], false);

    $stdout = '';
    $stderr = '';
    $deadline = microtime(true) + $timeout;

    while (true) {
        $remaining = $deadline - microtime(true);
        if ($remaining <= 0) {
            proc_terminate($process, 9);
            fclose($pipes[1]);
            fclose($pipes[2]);
            proc_close($process);

            return ['code' => -1, 'output' => 'Timed out after '.$timeout.'s'];
        }

        $status = proc_get_status($process);

        $stdout .= (string) stream_get_contents($pipes[1]);
        $stderr .= (string) stream_get_contents($pipes[2]);

        if (!$status['running']) {
            $stdout .= (string) stream_get_contents($pipes[1]);
            $stderr .= (string) stream_get_contents($pipes[2]);
            fclose($pipes[1]);
            fclose($pipes[2]);
            proc_close($process);

            return [
                'code' => $status['exitcode'],
                'output' => trim($stdout."\n".$stderr),
            ];
        }

        usleep(20000); // 20ms
    }
}

// ---------------------------------------------------------------------------
// Pull-command resolution (no I/O side effects)
// ---------------------------------------------------------------------------

function getCurrentBranch(string $repoPath, int $timeout): ?string
{
    $result = runGit($repoPath, ['rev-parse', '--abbrev-ref', 'HEAD'], $timeout);
    if (0 !== $result['code']) {
        return null;
    }

    $branch = trim($result['output']);

    return ('' === $branch || 'HEAD' === $branch) ? null : $branch;
}

function getHeadCommit(string $repoPath, int $timeout): ?string
{
    $result = runGit($repoPath, ['rev-parse', 'HEAD'], $timeout);
    if (0 !== $result['code']) {
        return null;
    }

    $commit = strtolower(trim($result['output']));

    return isCommitHash($commit) ? $commit : null;
}

/**
 * Count the commits between two revisions; null when git cannot tell (the
 * older commit is not in a shallow checkout, or the history was rewritten).
 */
function countCommitsBetween(string $repoPath, string $from, string $to, int $timeout): ?int
{
    if (0 !== runGit($repoPath, ['merge-base', '--is-ancestor', $from, $to], $timeout)['code']) {
        return null;
    }

    $result = runGit($repoPath, ['rev-list', '--count', $from.'..'.$to], $timeout);
    if (0 !== $result['code'] || !ctype_digit(trim($result['output']))) {
        return null;
    }

    return (int) trim($result['output']);
}

function getUpstreamRef(string $repoPath, int $timeout): ?string
{
    $result = runGit($repoPath, ['rev-parse', '--abbrev-ref', '--symbolic-full-name', '@{u}'], $timeout);
    if (0 !== $result['code']) {
        return null;
    }

    $ref = trim($result['output']);

    return '' === $ref ? null : $ref;
}

function remoteExists(string $repoPath, string $remote, int $timeout): bool
{
    $result = runGit($repoPath, ['remote', 'get-url', $remote], $timeout);

    return 0 === $result['code'] && '' !== trim($result['output']);
}

function getBranchRemote(string $repoPath, string $branch, int $timeout): ?string
{
    $result = runGit($repoPath, ['config', '--get', 'branch.'.$branch.'.remote'], $timeout);
    if (0 === $result['code']) {
        $remote = trim($result['output']);
        if ('' !== $remote) {
            return $remote;
        }
    }

    return remoteExists($repoPath, 'origin', $timeout) ? 'origin' : null;
}

function getBranchMergeRef(string $repoPath, string $branch, int $timeout): ?string
{
    $result = runGit($repoPath, ['config', '--get', 'branch.'.$branch.'.merge'], $timeout);
    if (0 !== $result['code']) {
        return null;
    }

    $mergeRef = trim($result['output']);

    return '' === $mergeRef ? null : $mergeRef;
}

function normalizeMergeRef(string $mergeRef): string
{
    $prefix = 'refs/heads/';
    if (str_starts_with($mergeRef, $prefix)) {
        return substr($mergeRef, \strlen($prefix));
    }

    return $mergeRef;
}

/**
 * Ask the remote which branch its HEAD points to (the default branch).
 */
function getRemoteDefaultBranch(string $repoPath, string $remote, int $timeout): ?string
{
    $result = runGit($repoPath, ['ls-remote', '--symref', $remote, 'HEAD'], $timeout);
    if (0 !== $result['code']) {
        return null;
    }

    if (1 === preg_match('~^ref:\s+refs/heads/(\S+)\s+HEAD~m', $result['output'], $matches)) {
        return $matches[1];
    }

    return null;
}

/**
 * Keep the remote's fetch refspec in sync after a branch switch: a
 * single-branch clone (the manifest default) keeps fetching only the branch
 * it was cloned from, so point the refspec at the branch now tracked. Clones
 * with a wildcard refspec are left untouched.
 */
function ensureFetchRefspec(string $repoPath, string $remote, string $branch, int $timeout): void
{
    $current = runGit($repoPath, ['config', '--get-all', 'remote.'.$remote.'.fetch'], $timeout);
    if (0 !== $current['code']) {
        return;
    }

    foreach (preg_split('/\R/', trim($current['output'])) ?: [] as $refspec) {
        if (str_contains($refspec, '*')) {
            return;
        }
    }

    runGit($repoPath, [
        'config',
        'remote.'.$remote.'.fetch',
        sprintf('+refs/heads/%s:refs/remotes/%s/%s', $branch, $remote, $branch),
    ], $timeout);
}

/**
 * @return array{ok: bool, args?: array<int, string>, command?: string, note?: string, message?: string}
 */
function resolvePullCommand(string $repoPath, int $timeout): array
{
    $upstream = getUpstreamRef($repoPath, $timeout);
    if (null !== $upstream) {
        return [
            'ok' => true,
            'args' => ['pull', '--rebase'],
            'command' => 'git pull --rebase',
        ];
    }

    $branch = getCurrentBranch($repoPath, $timeout);
    if (null === $branch) {
        return [
            'ok' => false,
            'message' => 'Detached HEAD or unable to determine current branch.',
        ];
    }

    $remote = getBranchRemote($repoPath, $branch, $timeout);
    if (null === $remote) {
        return [
            'ok' => false,
            'message' => 'No git remote found for branch '.$branch.'.',
        ];
    }

    $mergeRef = getBranchMergeRef($repoPath, $branch, $timeout);
    $remoteBranch = null !== $mergeRef ? normalizeMergeRef($mergeRef) : $branch;

    return [
        'ok' => true,
        'args' => ['pull', '--rebase', $remote, $remoteBranch],
        'command' => 'git pull --rebase '.$remote.' '.$remoteBranch,
        'note' => 'No upstream configured; pulling '.$remote.'/'.$remoteBranch.'.',
    ];
}

// ---------------------------------------------------------------------------
// Combined prepare + update per repo (runs inside worker)
// ---------------------------------------------------------------------------

/**
 * @param array<string, ?string> $branches Map of manifest repository labels to their configured branch
 *
 * @return array{path: string, status: string, output: string, command: string, code: int, log: array<string>}
 */
function processRepo(string $repoPath, bool $force, string $corpusDir, bool $debug, int $timeout, array $branches = []): array
{
    $log = [];
    $fail = static fn (string $msg, string $cmd = 'N/A', int $code = 1): array => [
        'path' => $repoPath,
        'status' => 'FAIL',
        'output' => $msg,
        'command' => $cmd,
        'code' => $code,
        'log' => $log,
    ];

    $git = static function (array $args) use ($repoPath, $timeout, $debug, &$log): array {
        $result = runGit($repoPath, $args, $timeout);
        if ($debug) {
            $cmdStr = 'git '.implode(' ', array_map('escapeshellarg', $args));
            $detail = 0 === $result['code'] && '' === $result['output'] ? '(no output)' : $result['output'];
            $log[] = $cmdStr.' → exit '.$result['code'].': '.$detail;
        }

        return $result;
    };

    // Safety check
    if (!isSafeRepo($repoPath, $corpusDir)) {
        return [
            'path' => $repoPath,
            'status' => 'SKIP',
            'output' => 'Outside corpus directory.',
            'command' => 'N/A',
            'code' => 0,
            'log' => $log,
        ];
    }

    // --- Prepare phase ---
    if ($force) {
        $reset = $git(['reset', '--hard', 'HEAD']);
        if (0 !== $reset['code']) {
            return $fail('Reset failed: '.$reset['output']);
        }

        $clean = $git(['clean', '-fd']);
        if (0 !== $clean['code']) {
            return $fail('Clean failed: '.$clean['output']);
        }
    } else {
        $status = $git(['status', '--porcelain']);
        if (0 !== $status['code']) {
            return $fail($status['output']);
        }

        if ('' !== $status['output']) {
            return [
                'path' => $repoPath,
                'status' => 'SKIP',
                'output' => 'Dirty working tree (use --force to reset).',
                'command' => 'N/A',
                'code' => 0,
                'log' => $log,
            ];
        }
    }

    // --- Branch phase ---
    // The manifest branch is authoritative: switch before pulling so that a
    // branch bump in corpus.json propagates to the checkout.
    $branchNote = '';
    $branch = $branches[formatRepoLabel($repoPath, $corpusDir)] ?? null;
    $currentBranch = null !== $branch ? getCurrentBranch($repoPath, $timeout) : null;

    if (null !== $branch && null !== $currentBranch && $currentBranch !== $branch) {
        $remote = getBranchRemote($repoPath, $currentBranch, $timeout);
        $remote ??= remoteExists($repoPath, 'origin', $timeout) ? 'origin' : null;

        if (null === $remote) {
            return $fail('No git remote found for branch '.$currentBranch.'.');
        }

        $fetch = $git(['fetch', $remote, '+refs/heads/'.$branch.':refs/remotes/'.$remote.'/'.$branch]);
        if (0 !== $fetch['code']) {
            return $fail('Configured branch '.$branch.' not found on '.$remote.': '.$fetch['output']);
        }

        // Point the fetch refspec at the new branch before the checkout: on a
        // single-branch clone, git refuses to set up tracking for a start
        // point that the remote's configured refspec does not cover.
        ensureFetchRefspec($repoPath, $remote, $branch, $timeout);

        $checkout = $git(['checkout', '-B', $branch, $remote.'/'.$branch]);
        if (0 !== $checkout['code']) {
            return $fail('Branch switch failed: '.$checkout['output']);
        }

        $git(['branch', '--set-upstream-to='.$remote.'/'.$branch, $branch]);
        $branchNote = 'Switched '.$currentBranch.' to '.$branch.' (configured branch).';
    }

    // --- Update phase ---
    $resolved = resolvePullCommand($repoPath, $timeout);
    if (!($resolved['ok'] ?? false)) {
        return $fail($resolved['message'] ?? 'Unable to resolve pull command.');
    }

    /** @var array<int, string> $args */
    $args = $resolved['args'] ?? ['pull', '--rebase'];
    $command = $resolved['command'] ?? 'git pull --rebase';

    $pull = $git($args);
    $output = $pull['output'];
    if (isset($resolved['note']) && '' !== $resolved['note']) {
        $output = $resolved['note'].('' === $output ? '' : PHP_EOL.$output);
    }
    if ('' !== $branchNote) {
        $output = $branchNote.('' === $output ? '' : PHP_EOL.$output);
    }

    // --- Self-heal phase ---
    // A pull can fail because the tracked branch was renamed or deleted on the
    // remote (e.g. master -> main, 5.x -> 6.x), or because fetching all refs
    // is impossible (case-colliding branch names on a case-insensitive
    // filesystem). In both cases, recover by switching to the remote's
    // current default branch, fetching only that single ref.
    if (0 !== $pull['code']) {
        $branch = getCurrentBranch($repoPath, $timeout);
        $remote = null !== $branch ? getBranchRemote($repoPath, $branch, $timeout) : null;
        $remote ??= remoteExists($repoPath, 'origin', $timeout) ? 'origin' : null;
        $default = null !== $remote ? getRemoteDefaultBranch($repoPath, $remote, $timeout) : null;

        if (null !== $remote && null !== $default) {
            $fetch = $git(['fetch', $remote, '+refs/heads/'.$default.':refs/remotes/'.$remote.'/'.$default]);
            if (0 === $fetch['code']) {
                // Same refspec dance as the branch phase: the checkout cannot
                // set up tracking for a ref the remote's refspec ignores.
                ensureFetchRefspec($repoPath, $remote, $default, $timeout);
                $checkout = $git(['checkout', '-B', $default, $remote.'/'.$default]);
                if (0 === $checkout['code']) {
                    $git(['branch', '--set-upstream-to='.$remote.'/'.$default, $default]);

                    $note = 'Tracked branch no longer on remote; switched to default branch '.$remote.'/'.$default.'.';

                    return [
                        'path' => $repoPath,
                        'status' => 'OK',
                        'output' => $note,
                        'command' => $command.' (recovered via '.$remote.'/'.$default.')',
                        'code' => 0,
                        'log' => $log,
                        'notes' => [$note],
                    ];
                }
            }
        }
    }

    return [
        'path' => $repoPath,
        'status' => 0 === $pull['code'] ? 'OK' : 'FAIL',
        'output' => $output,
        'command' => $command,
        'code' => $pull['code'],
        'log' => $log,
        'notes' => array_values(array_filter([$branchNote, $resolved['note'] ?? ''], static fn (string $n): bool => '' !== $n)),
    ];
}

/**
 * Update one checkout and report where it moved, measured against the commit
 * the manifest recorded (or the local HEAD when the manifest has none yet).
 *
 * @param array<string, ?string> $branches Map of manifest repository labels to their configured branch
 * @param array<string, ?string> $locked   Map of manifest repository labels to their recorded commit
 *
 * @return array{path: string, status: string, output: string, command: string, code: int, log: array<string>, change: ?string, commit: ?string, previous: ?string, count: ?int}
 */
function syncRepo(
    string $repoPath,
    bool $force,
    string $corpusDir,
    bool $debug,
    int $timeout,
    array $branches = [],
    array $locked = [],
): array {
    $before = getHeadCommit($repoPath, $timeout);
    $result = processRepo($repoPath, $force, $corpusDir, $debug, $timeout, $branches);
    $after = getHeadCommit($repoPath, $timeout);
    $previous = $locked[formatRepoLabel($repoPath, $corpusDir)] ?? $before;

    $change = null;
    $count = null;
    if ('OK' === $result['status']) {
        $change = null === $previous || null === $after || $previous === $after ? 'unchanged' : 'updated';
        if ('updated' === $change) {
            $count = countCommitsBetween($repoPath, (string) $previous, (string) $after, $timeout);
        }
    }

    return $result + ['change' => $change, 'commit' => $after, 'previous' => $previous, 'count' => $count];
}

// ---------------------------------------------------------------------------
// Worker-pool parallel execution
// ---------------------------------------------------------------------------

/**
 * @param array<string>          $repos
 * @param array<string, ?string> $branches Map of manifest repository labels to their configured branch
 * @param array<string, ?string> $locked   Map of manifest repository labels to their recorded commit
 *
 * @return array<int, array<string, mixed>>
 */
function processReposParallel(
    array $repos,
    int $jobs,
    bool $force,
    string $corpusDir,
    bool $debug,
    int $timeout,
    callable $onComplete,
    array $branches = [],
    array $locked = [],
): array {
    $results = [];
    $queue = $repos;
    /** @var array<int, array{tmp: string, repo: string}> $active */
    $active = [];
    $completed = 0;
    $total = \count($repos);

    while ($queue || $active) {
        // Fill worker slots
        while (\count($active) < $jobs && $queue) {
            $repo = array_shift($queue);
            $tmp = tempnam(sys_get_temp_dir(), 'corpus_');
            if (false === $tmp) {
                $results[] = syncRepo($repo, $force, $corpusDir, $debug, $timeout, $branches, $locked);
                $completed++;
                $onComplete($completed, $total);
                continue;
            }

            $pid = pcntl_fork();
            if (-1 === $pid) {
                @unlink($tmp);
                $results[] = syncRepo($repo, $force, $corpusDir, $debug, $timeout, $branches, $locked);
                $completed++;
                $onComplete($completed, $total);
                continue;
            }

            if (0 === $pid) {
                // Child: process single repo, write result, exit
                $result = syncRepo($repo, $force, $corpusDir, $debug, $timeout, $branches, $locked);
                file_put_contents($tmp, serialize($result));
                exit(0);
            }

            $active[$pid] = ['tmp' => $tmp, 'repo' => $repo];
        }

        if ([] === $active) {
            break;
        }

        // Wait for any child to finish
        $pid = pcntl_waitpid(-1, $status);
        if ($pid > 0 && isset($active[$pid])) {
            $info = $active[$pid];
            unset($active[$pid]);

            $data = @file_get_contents($info['tmp']);
            @unlink($info['tmp']);

            if (false !== $data) {
                $decoded = @unserialize($data);
                if (\is_array($decoded)) {
                    $results[] = $decoded;
                } else {
                    $results[] = [
                        'path' => $info['repo'],
                        'status' => 'FAIL',
                        'output' => 'Worker produced invalid result.',
                        'command' => 'N/A',
                        'code' => 1,
                        'log' => [],
                    ];
                }
            } else {
                $results[] = [
                    'path' => $info['repo'],
                    'status' => 'FAIL',
                    'output' => 'Worker result file missing.',
                    'command' => 'N/A',
                    'code' => 1,
                    'log' => [],
                ];
            }

            $completed++;
            $onComplete($completed, $total);
        }
    }

    return $results;
}

// ---------------------------------------------------------------------------
// Progress rendering
// ---------------------------------------------------------------------------

function canUseDynamicProgress(): bool
{
    return \function_exists('posix_isatty') && posix_isatty(\STDOUT);
}

function renderProgress(int $current, int $total, bool $dynamic, bool $final = false): void
{
    $total = max(1, $total);
    $ratio = min(1, $current / $total);
    $width = 28;
    $filled = (int) floor($ratio * $width);
    $bar = str_repeat('#', $filled).str_repeat('-', $width - $filled);
    $percent = str_pad((string) round($ratio * 100), 3, ' ', \STR_PAD_LEFT);
    $line = sprintf('  [%s] %s%% %d/%d', $bar, $percent, $current, $total);

    if ($dynamic) {
        echo "\r\033[2K".$line;
        if ($final) {
            echo PHP_EOL;
        }

        return;
    }

    echo $line.PHP_EOL;
}

// ---------------------------------------------------------------------------
// Result printing
// ---------------------------------------------------------------------------

function shortCommit(?string $commit): string
{
    return null === $commit ? '?' : substr($commit, 0, 7);
}

/**
 * One line saying where a checkout stands against the manifest.
 */
function describeChange(array $result): string
{
    return match ($result['change'] ?? null) {
        'updated' => sprintf(
            '%s..%s%s',
            shortCommit($result['previous'] ?? null),
            shortCommit($result['commit'] ?? null),
            null === ($result['count'] ?? null) ? '' : sprintf(' (%d commit%s)', $result['count'], 1 === $result['count'] ? '' : 's'),
        ),
        'cloned' => 'at '.shortCommit($result['commit'] ?? null),
        'removed' => 'no longer in corpus.json',
        default => 'up to date at '.shortCommit($result['commit'] ?? null),
    };
}

function printResult(array $result, string $corpusDir, ConsoleStyle $io, bool $debug): void
{
    $label = formatRepoLabel($result['path'], $corpusDir);

    $detail = '';
    if ($debug) {
        $lines = [];
        if ([] !== ($result['log'] ?? [])) {
            $lines = array_merge($lines, $result['log']);
        }
        $detail = implode(PHP_EOL, $lines);
    } elseif ('OK' === $result['status'] && isset($result['change'])) {
        // The commit range says what the pull did; keep only the notes.
        $detail = implode(PHP_EOL, $result['notes'] ?? []);
    } elseif ('' !== ($result['output'] ?? '')) {
        $detail = $result['output'];
    }

    switch ($result['status']) {
        case 'OK':
            $change = $result['change'] ?? null;
            $tag = match ($change) {
                'updated' => $io->green('[UPDATED]'),
                'cloned' => $io->green('[CLONED]'),
                'removed' => $io->yellow('[REMOVED]'),
                default => $io->dim('[OK]'),
            };
            $message = null === $change ? $label : $label.'  '.$io->dim(describeChange($result));
            $io->status($tag, $message, $detail);
            break;
        case 'SKIP':
            $io->status($io->yellow('[SKIP]'), $label, $detail);
            break;
        case 'FAIL':
        default:
            $statusTag = -1 === ($result['code'] ?? 0) ? '[TIMEOUT]' : '[FAIL]';
            $io->status($io->red($statusTag), $label, $detail);
            break;
    }
}

// ---------------------------------------------------------------------------
// Manifest commands
// ---------------------------------------------------------------------------

/**
 * @param array<string, array{url: string, branch: ?string, depth: int, commit: ?string}> $repositories
 *
 * @return array<string, array{url: string, branch: ?string, depth: int, commit: ?string}>
 */
function missingRepositories(array $repositories, string $corpusDir): array
{
    $missing = [];
    foreach ($repositories as $relPath => $entry) {
        if (!is_dir($corpusDir.\DIRECTORY_SEPARATOR.$relPath.'/.git')) {
            $missing[$relPath] = $entry;
        }
    }

    return $missing;
}

/**
 * @param array<string, array{url: string, branch: ?string, depth: int, commit: ?string}> $missing
 *
 * @return array<int, array<string, mixed>>
 */
function cloneMissing(
    array $missing,
    int $jobs,
    string $corpusDir,
    bool $debug,
    int $timeout,
    bool $dynamicProgress,
): array {
    $items = [];
    foreach ($missing as $relPath => $entry) {
        $items[] = ['path' => $relPath, 'entry' => $entry];
    }

    $task = static fn (array $item): array => cloneRepo(
        $item['path'],
        $item['entry'],
        $corpusDir,
        $debug,
        $timeout,
    );

    $onComplete = static function (int $current, int $total) use ($dynamicProgress): void {
        renderProgress($current, $total, $dynamicProgress, $current >= $total);
    };

    renderProgress(0, \count($items), $dynamicProgress);
    $results = runJobsParallel($items, $jobs, $task, $onComplete);

    usort($results, static fn (array $a, array $b): int => strcmp($a['path'] ?? '', $b['path'] ?? ''));

    return $results;
}

function writeManifestCommand(string $manifestFile, string $corpusDir, int $timeout, ConsoleStyle $io): int
{
    $defaults = is_file($manifestFile) ? loadManifest($manifestFile)['defaults'] : MANIFEST_DEFAULTS;
    $repos = findGitRepos($corpusDir);

    if ([] === $repos) {
        $io->error('No git repositories found in corpus/; refusing to write an empty manifest.');

        return 1;
    }

    $built = buildManifestFromDisk($corpusDir, $repos, $defaults, $timeout);
    saveManifest($manifestFile, ['defaults' => $built['defaults'], 'repositories' => $built['repositories']]);

    $io->info(sprintf('Wrote %d repositories to %s.', \count($built['repositories']), $manifestFile));
    foreach ($built['skipped'] as $relPath) {
        $io->warn(sprintf('Skipped %s: no usable "%s" remote.', $relPath, $defaults['remote']));
    }

    return 0;
}

/**
 * @param array<string, mixed> $options
 */
function addCommand(
    array $options,
    string $manifestFile,
    string $corpusDir,
    bool $debug,
    int $timeout,
    ConsoleStyle $io,
): int {
    /** @var array<int, string> $urls */
    $urls = $options['add'];
    $as = \is_string($options['as']) ? normalizeManifestPath($options['as']) : null;

    if (null !== $as && \count($urls) > 1) {
        $io->error('The --as option cannot be combined with several --add options.');

        return 1;
    }

    $depth = null;
    if (\is_string($options['depth'])) {
        if (!ctype_digit($options['depth'])) {
            $io->error('The --depth value must be a non-negative integer.');

            return 1;
        }
        $depth = (int) $options['depth'];
    }

    $manifest = loadManifest($manifestFile);
    $failed = 0;

    foreach ($urls as $url) {
        $url = trim($url);
        if (!isValidRepoUrl($url)) {
            $io->error(sprintf('Unsupported repository URL: %s', $url));
            $failed++;
            continue;
        }

        $relPath = $as ?? deriveTargetPath($url, $manifest['repositories']);

        if (isset($manifest['repositories'][$relPath]) && $manifest['repositories'][$relPath]['url'] !== $url) {
            $io->error(sprintf('The manifest already maps %s to %s; pass --as to pick another path.', $relPath, $manifest['repositories'][$relPath]['url']));
            $failed++;
            continue;
        }

        $entry = [
            'url' => normalizeCloneUrl($url, $manifest['defaults']['protocol']),
            'branch' => \is_string($options['branch']) && '' !== trim($options['branch']) ? trim($options['branch']) : null,
            'depth' => $depth ?? $manifest['defaults']['depth'],
            'commit' => null,
        ];

        $result = cloneRepo($relPath, $entry, $corpusDir, $debug, $timeout);
        printResult($result, $corpusDir, $io, $debug);

        if ('FAIL' === $result['status']) {
            $failed++;
            continue;
        }

        $entry['branch'] ??= getCurrentBranch($corpusDir.\DIRECTORY_SEPARATOR.$relPath, $timeout);
        $entry['commit'] = $result['commit'] ?? getHeadCommit($corpusDir.\DIRECTORY_SEPARATOR.$relPath, $timeout);
        $manifest['repositories'][$relPath] = $entry;
        saveManifest($manifestFile, $manifest);

        $io->info(sprintf('  Added %s to %s.', $relPath, basename($manifestFile)));
    }

    return $failed > 0 ? 1 : 0;
}

/**
 * @param array<string, array{url: string, branch: ?string, depth: int, commit: ?string}> $repositories
 * @param array<string>                                                  $repos
 */
function printManifestDrift(array $repositories, array $repos, string $corpusDir, ConsoleStyle $io): void
{
    $untracked = [];
    foreach ($repos as $repoPath) {
        $relPath = formatRepoLabel($repoPath, $corpusDir);
        if (!isset($repositories[$relPath])) {
            $untracked[] = $relPath;
        }
    }

    if ([] === $untracked) {
        return;
    }

    $io->info('');
    $io->warn(sprintf('%d repositories on disk are not in the manifest; run corpus/update --write-manifest to list them.', \count($untracked)));
    foreach (\array_slice($untracked, 0, 10) as $relPath) {
        $io->info('  - '.$relPath);
    }
    if (\count($untracked) > 10) {
        $io->info('  ... and '.(\count($untracked) - 10).' more');
    }
}

/**
 * The checkouts on disk that the manifest no longer lists.
 *
 * @param array<string, array{url: string, branch: ?string, depth: int, commit: ?string}> $repositories
 * @param array<string>                                                                  $repos
 *
 * @return array<string>
 */
function unlistedRepos(array $repositories, array $repos, string $corpusDir): array
{
    return array_values(array_filter(
        $repos,
        static fn (string $repoPath): bool => !isset($repositories[formatRepoLabel($repoPath, $corpusDir)]),
    ));
}

/**
 * Delete the checkouts whose manifest entry was removed. A checkout with local
 * changes is kept unless --force is given, and so is one that still holds a
 * listed checkout below it.
 *
 * @param array<string, array{url: string, branch: ?string, depth: int, commit: ?string}> $repositories
 * @param array<string>                                                                  $unlisted
 *
 * @return array<int, array<string, mixed>>
 */
function pruneUnlisted(array $repositories, array $unlisted, string $corpusDir, bool $force, int $timeout): array
{
    $results = [];

    foreach ($unlisted as $repoPath) {
        $relPath = formatRepoLabel($repoPath, $corpusDir);
        $result = static fn (string $status, string $output, int $code = 0): array => [
            'path' => $repoPath,
            'status' => $status,
            'output' => $output,
            'command' => 'N/A',
            'code' => $code,
            'log' => [],
            'change' => 'OK' === $status ? 'removed' : null,
        ];

        if (!isSafeRepo($repoPath, $corpusDir)) {
            $results[] = $result('SKIP', 'Outside corpus directory.');
            continue;
        }

        foreach (array_keys($repositories) as $listed) {
            if (str_starts_with($listed, $relPath.'/')) {
                $results[] = $result('SKIP', sprintf('Not removed: it contains the listed checkout %s.', $listed));
                continue 2;
            }
        }

        if (!$force) {
            $status = runGit($repoPath, ['status', '--porcelain'], $timeout);
            if (0 !== $status['code']) {
                $results[] = $result('FAIL', $status['output'], $status['code']);
                continue;
            }
            if ('' !== $status['output']) {
                $results[] = $result('SKIP', 'Not removed: local changes (use --force to remove it anyway).');
                continue;
            }
        }

        if (!removeTree($repoPath)) {
            $results[] = $result('FAIL', sprintf('Unable to remove %s.', $repoPath), 1);
            continue;
        }

        removeEmptyParents(\dirname($repoPath), $corpusDir);
        $results[] = $result('OK', '');
    }

    return $results;
}

/**
 * Delete a directory tree without following symlinks out of it.
 */
function removeTree(string $path): bool
{
    if (is_link($path) || is_file($path)) {
        return @unlink($path);
    }

    $iterator = new RecursiveIteratorIterator(
        new RecursiveDirectoryIterator($path, FilesystemIterator::SKIP_DOTS),
        RecursiveIteratorIterator::CHILD_FIRST,
    );

    foreach ($iterator as $file) {
        /** @var SplFileInfo $file */
        $pathname = $file->getPathname();
        if ($file->isLink() || !$file->isDir()) {
            // Git packs are read-only; Windows refuses to unlink those.
            if (!@unlink($pathname) && !(@chmod($pathname, 0o666) && @unlink($pathname))) {
                return false;
            }
            continue;
        }

        if (!@rmdir($pathname)) {
            return false;
        }
    }

    return @rmdir($path);
}

/**
 * Remove the directories left empty by a pruned checkout (api-platform/ once
 * api-platform/core is gone), stopping at corpus/ itself.
 */
function removeEmptyParents(string $dir, string $corpusDir): void
{
    $root = rtrim($corpusDir, \DIRECTORY_SEPARATOR).\DIRECTORY_SEPARATOR;

    while (str_starts_with($dir.\DIRECTORY_SEPARATOR, $root) && $dir.\DIRECTORY_SEPARATOR !== $root) {
        $entries = scandir($dir);
        if (false === $entries || [] !== array_diff($entries, ['.', '..', '.DS_Store'])) {
            return;
        }

        @unlink($dir.\DIRECTORY_SEPARATOR.'.DS_Store');
        if (!@rmdir($dir)) {
            return;
        }

        $dir = \dirname($dir);
    }
}

/**
 * Write the commit each checkout ended on back into the manifest, the way a
 * lock file pins what was installed.
 *
 * @param array{defaults: array{remote: string, depth: int}, repositories: array<string, array{url: string, branch: ?string, depth: int, commit: ?string}>} $manifest
 * @param array<int, array<string, mixed>>                                                                                                                    $results
 */
function recordCommits(string $manifestFile, array $manifest, array $results, string $corpusDir, ConsoleStyle $io): void
{
    $changed = false;

    foreach ($results as $result) {
        $commit = $result['commit'] ?? null;
        if (!\is_string($commit)) {
            continue;
        }

        $relPath = formatRepoLabel($result['path'], $corpusDir);
        if (!isset($manifest['repositories'][$relPath]) || $manifest['repositories'][$relPath]['commit'] === $commit) {
            continue;
        }

        $manifest['repositories'][$relPath]['commit'] = $commit;
        $changed = true;
    }

    if (!$changed) {
        return;
    }

    try {
        saveManifest($manifestFile, $manifest);
    } catch (RuntimeException $e) {
        $io->error($e->getMessage());
    }
}

/**
 * @param array<int, array<string, mixed>> $results
 */
function countFailures(array $results): int
{
    $failed = 0;
    foreach ($results as $result) {
        if ('OK' !== $result['status'] && 'SKIP' !== $result['status']) {
            $failed++;
        }
    }

    return $failed;
}

/**
 * @param array<int, array<string, mixed>> $results
 */
function printSummary(array $results, float $elapsed, ConsoleStyle $io): void
{
    $counts = ['cloned' => 0, 'updated' => 0, 'unchanged' => 0, 'removed' => 0];
    $failed = 0;
    $skipped = 0;
    $timedOut = 0;

    foreach ($results as $result) {
        switch ($result['status']) {
            case 'OK':
                $change = $result['change'] ?? 'unchanged';
                $counts[isset($counts[$change]) ? $change : 'unchanged']++;
                break;
            case 'SKIP':
                $skipped++;
                break;
            default:
                if (-1 === ($result['code'] ?? 0)) {
                    $timedOut++;
                }
                $failed++;
                break;
        }
    }

    $io->info('');
    $io->info($io->bold('Summary'));
    $io->info('Cloned   : '.$counts['cloned']);
    $io->info('Updated  : '.$counts['updated']);
    $io->info('Unchanged: '.$counts['unchanged']);
    $io->info('Removed  : '.$counts['removed']);
    $io->info('Failed   : '.$failed.($timedOut > 0 ? ' ('.$timedOut.' timed out)' : ''));
    $io->info('Skipped  : '.$skipped);
    $io->info('Elapsed  : '.round($elapsed, 1).'s');
}

// ---------------------------------------------------------------------------
// Main
// ---------------------------------------------------------------------------

function main(array $argv): int
{
    $io = new ConsoleStyle();

    try {
        $options = parseArgs($argv);
    } catch (InvalidArgumentException $e) {
        $io->error($e->getMessage());
        printUsage();

        return 1;
    }

    if ($options['help']) {
        printUsage();

        return 0;
    }

    $corpusDir = realpath(__DIR__);
    if (false === $corpusDir) {
        $io->error('Unable to resolve corpus directory.');

        return 1;
    }

    // --- Resolve jobs ---
    $jobs = $options['jobs'];
    if (null === $jobs || '' === $jobs || 'auto' === $jobs) {
        $jobs = max(2, detectCpuCount() * 2);
    } else {
        $jobs = trim((string) $jobs);
        if (!ctype_digit($jobs)) {
            $io->error('The --jobs value must be a positive integer or "auto".');

            return 1;
        }
    }

    $jobs = (int) $jobs;
    if ($jobs < 1) {
        $io->error('The --jobs value must be a positive integer or "auto".');

        return 1;
    }

    if ($jobs > 1 && !supportsParallel()) {
        $io->warn('Parallel jobs requested but pcntl is unavailable; falling back to 1 job.');
        $jobs = 1;
    }

    // --- Resolve timeout ---
    $timeout = $options['timeout'];
    if (null === $timeout || '' === $timeout) {
        $timeout = 120;
    } else {
        $timeout = trim((string) $timeout);
        if (!ctype_digit($timeout)) {
            $io->error('The --timeout value must be a positive integer.');

            return 1;
        }
        $timeout = (int) $timeout;
    }

    $debug = (bool) $options['debug'];
    $force = (bool) $options['force'];
    $manifestFile = manifestPath($corpusDir);

    // --- Manifest-only commands ---
    try {
        if ($options['write-manifest']) {
            return writeManifestCommand($manifestFile, $corpusDir, $timeout, $io);
        }

        if ([] !== $options['add']) {
            return addCommand($options, $manifestFile, $corpusDir, $debug, $timeout, $io);
        }

        $manifest = loadManifest($manifestFile);
    } catch (RuntimeException $e) {
        $io->error($e->getMessage());

        return 1;
    }

    $missing = missingRepositories($manifest['repositories'], $corpusDir);
    $repos = findGitRepos($corpusDir);
    $branches = array_map(
        static fn (array $entry): ?string => $entry['branch'],
        $manifest['repositories'],
    );
    $locked = array_map(
        static fn (array $entry): ?string => $entry['commit'],
        $manifest['repositories'],
    );

    // An absent or empty manifest lists nothing on purpose; never read it as
    // "remove every checkout".
    $unlisted = [];
    if ($options['prune'] && [] !== $manifest['repositories']) {
        $unlisted = unlistedRepos($manifest['repositories'], $repos, $corpusDir);
    }

    $io->header('Corpus Updater');
    $io->info('Runtime : PHP '.PHP_VERSION);
    $io->info('Corpus  : '.$corpusDir);
    $io->info('Jobs    : '.$jobs);
    $io->info('Timeout : '.$timeout.'s per repo');
    $io->info('Force   : '.($force ? 'yes' : 'no'));
    $io->info('Debug   : '.($debug ? 'on' : 'off'));
    $io->info('Manifest: '.(is_file($manifestFile)
        ? \count($manifest['repositories']).' entries'
            .([] === $missing ? '' : ', '.\count($missing).' missing on disk')
            .([] === $unlisted ? '' : ', '.\count($unlisted).' to remove')
        : 'not found (run corpus/update --write-manifest)'));
    $io->info('Repos   : '.\count($repos));
    $io->info('');

    $dynamicProgress = canUseDynamicProgress() && !$debug;
    $startTime = microtime(true);

    // --- Prune phase ---
    $pruneResults = [];
    if ([] !== $unlisted) {
        $io->info($io->bold('Removing '.\count($unlisted).' repositories no longer in corpus.json'));
        $pruneResults = pruneUnlisted($manifest['repositories'], $unlisted, $corpusDir, $force, $timeout);

        foreach ($pruneResults as $result) {
            printResult($result, $corpusDir, $io, $debug);
        }

        $io->info('');
        $repos = findGitRepos($corpusDir);
    }

    // --- Clone phase ---
    $cloneResults = [];
    if ($options['clone'] && [] !== $missing) {
        $io->info($io->bold('Cloning '.\count($missing).' missing repositories'));
        $cloneResults = cloneMissing($missing, $jobs, $corpusDir, $debug, $timeout, $dynamicProgress);
        $io->info('');

        foreach ($cloneResults as $result) {
            printResult($result, $corpusDir, $io, $debug);
        }

        $io->info('');
        $repos = findGitRepos($corpusDir);
    }

    if ($options['clone-only']) {
        $results = array_merge($pruneResults, $cloneResults);
        recordCommits($manifestFile, $manifest, $results, $corpusDir, $io);
        printSummary($results, microtime(true) - $startTime, $io);

        return countFailures($results) > 0 ? 1 : 0;
    }

    if ([] === $repos) {
        $io->info('No git repositories found in corpus/.');

        return countFailures(array_merge($pruneResults, $cloneResults)) > 0 ? 1 : 0;
    }

    if (1 === $jobs) {
        // Sequential: print each result immediately
        $results = [];
        $total = \count($repos);
        renderProgress(0, $total, $dynamicProgress);

        foreach ($repos as $i => $repo) {
            $result = syncRepo($repo, $force, $corpusDir, $debug, $timeout, $branches, $locked);
            $results[] = $result;

            if ($debug) {
                printResult($result, $corpusDir, $io, $debug);
            }

            renderProgress($i + 1, $total, $dynamicProgress, $i + 1 >= $total);
        }
    } else {
        // Parallel: worker pool
        $onComplete = static function (int $current, int $total) use ($dynamicProgress): void {
            renderProgress($current, $total, $dynamicProgress, $current >= $total);
        };

        renderProgress(0, \count($repos), $dynamicProgress);
        $results = processReposParallel($repos, $jobs, $force, $corpusDir, $debug, $timeout, $onComplete, $branches, $locked);
    }

    $elapsed = microtime(true) - $startTime;
    $io->info('');

    // --- Print results (parallel mode deferred; sequential already printed in debug) ---
    if ($jobs > 1) {
        // Sort results by path to match repo order
        usort($results, static fn (array $a, array $b): int => strcmp($a['path'] ?? '', $b['path'] ?? ''));

        foreach ($results as $result) {
            printResult($result, $corpusDir, $io, $debug);
        }
    } elseif (!$debug) {
        // Sequential non-debug: print compact results
        foreach ($results as $result) {
            printResult($result, $corpusDir, $io, false);
        }
    }

    // --- Summary ---
    $results = array_merge($pruneResults, $cloneResults, $results);
    recordCommits($manifestFile, $manifest, $results, $corpusDir, $io);
    printSummary($results, $elapsed, $io);
    printManifestDrift($manifest['repositories'], $repos, $corpusDir, $io);

    return countFailures($results) > 0 ? 1 : 0;
}

exit(main($argv));
