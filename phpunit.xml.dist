<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="tools/phpunit/vendor/phpunit/phpunit/phpunit.xsd"
         backupGlobals="false"
         colors="true"
         bootstrap="tests/bootstrap.php"
         cacheDirectory=".cache/phpunit/"
         executionOrder="random"
         displayDetailsOnAllIssues="true"
         displayDetailsOnIncompleteTests="true"
         displayDetailsOnPhpunitDeprecations="true"
         displayDetailsOnSkippedTests="true"
         displayDetailsOnTestsThatTriggerDeprecations="true"
         displayDetailsOnTestsThatTriggerErrors="true"
         displayDetailsOnTestsThatTriggerNotices="true"
         displayDetailsOnTestsThatTriggerWarnings="true"
         resolveDependencies="true">
    <!--
        The deprecation policy: a PHP deprecation whose frame lands under
        src/ — this library deprecating itself — fails the run through the
        SourceDeprecationListener extension below. Its subscribers throw,
        and PHPUnit reports a third-party subscriber exception as a test
        runner warning that exits the run non-zero whatever this file
        says about warnings. Every vendor or tool deprecation stays
        PHPUnit's display-only signal: the weekly re-resolved locks
        deprecate for reasons that are not this library's, and a chronic
        red trains people to ignore the signal. PHPUnit's own
        failOnDeprecation is rejected for exactly that reason: it does not
        tell own deprecations from vendor ones.
    -->
    <php>
        <ini name="memory_limit" value="-1"/>
        <ini name="error_reporting" value="-1"/>
        <ini name="display_errors" value="stderr"/>
        <ini name="log_errors" value="true"/>
        <ini name="serialize_precision" value="-1"/>
    </php>
    <extensions>
        <bootstrap class="PHPRegex\Tests\Support\SourceDeprecationListener"/>
    </extensions>
    <testsuites>
        <testsuite name="PHPRegex Test Suite">
            <directory>tests</directory>
        </testsuite>
    </testsuites>

    <groups>
        <exclude>
            <group>capture-shape-parity</group>
            <group>formatter-corpus</group>
        </exclude>
    </groups>

    <source>
        <include>
            <directory>src</directory>
        </include>
        <exclude>
            <directory>src/Parser/Exception</directory>
            <directory>src/Automata/Exception</directory>
            <!-- The IDE completion files are the editor's own DSL: never
                 executed, so never counted -->
            <file>src/Parser/.phpstorm.meta.php</file>
            <file>src/Redos/.phpstorm.meta.php</file>
            <file>src/Toolkit/.phpstorm.meta.php</file>
        </exclude>
    </source>
</phpunit>
