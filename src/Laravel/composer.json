{
    "name": "php-regex/regex-laravel",
    "type": "library",
    "description": "Laravel integration for PHPRegex: the Regex service and facade, and the regex:lint, regex:routes, regex:explain, regex:compare and regex:transpile commands.",
    "keywords": [
        "regex",
        "pcre",
        "laravel"
    ],
    "homepage": "https://github.com/php-regex/php-regex",
    "license": "MIT",
    "authors": [
        {
            "name": "Younes ENNAJI",
            "email": "younes.ennaji.pro@gmail.com"
        }
    ],
    "require": {
        "php": ">=8.2",
        "illuminate/console": "^12.0",
        "illuminate/contracts": "^12.0",
        "illuminate/routing": "^12.0",
        "illuminate/support": "^12.0",
        "symfony/console": "^7.4|^8.0",
        "php-regex/regex-automata": "^2.0",
        "php-regex/regex-linter": "^2.0",
        "php-regex/regex-optimizer": "^2.0",
        "php-regex/regex-parser": "^2.0",
        "php-regex/regex-redos": "^2.0",
        "php-regex/regex-toolkit": "^2.0",
        "php-regex/regex-transpiler": "^2.0"
    },
    "suggest": {
        "nikic/php-parser": "To extract patterns with a full PHP parser."
    },
    "autoload": {
        "psr-4": {
            "PHPRegex\\Laravel\\": ""
        }
    },
    "extra": {
        "branch-alias": {
            "dev-2.x": "2.x-dev"
        },
        "laravel": {
            "providers": [
                "PHPRegex\\Laravel\\PHPRegexServiceProvider"
            ],
            "aliases": {
                "Regex": "PHPRegex\\Laravel\\Facades\\Regex"
            }
        }
    }
}
