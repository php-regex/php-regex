{
    "name": "php-regex/regex-toolkit",
    "type": "library",
    "description": "One entry point to every PHPRegex library: parse, validate, explain, check ReDoS, optimize, generate, transpile and lint.",
    "keywords": [
        "regex",
        "pcre",
        "pcre2",
        "toolkit"
    ],
    "homepage": "https://github.com/php-regex/php-regex",
    "license": "MIT",
    "authors": [
        {
            "name": "Younes ENNAJI",
            "email": "younes.ennaji.pro@gmail.com"
        }
    ],
    "require": {
        "php": ">=8.2",
        "php-regex/regex-explain": "^2.0",
        "php-regex/regex-generator": "^2.0",
        "php-regex/regex-linter": "^2.0",
        "php-regex/regex-optimizer": "^2.0",
        "php-regex/regex-parser": "^2.0",
        "php-regex/regex-redos": "^2.0",
        "php-regex/regex-transpiler": "^2.0"
    },
    "suggest": {
        "rector/rector": "To run the 1.x to 2.0 upgrade set in Resources/rector."
    },
    "autoload": {
        "psr-4": {
            "PHPRegex\\Toolkit\\": ""
        }
    },
    "extra": {
        "branch-alias": {
            "dev-2.x": "2.x-dev"
        }
    }
}
