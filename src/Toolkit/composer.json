{
    "name": "php-regex/regex-toolkit",
    "type": "library",
    "description": "One entry point to every PHPRegex analysis library: parse, validate, explain, check ReDoS, optimize, generate, transpile and lint.",
    "keywords": [
        "regex",
        "pcre",
        "pcre2",
        "toolkit"
    ],
    "homepage": "https://github.com/php-regex/php-regex",
    "license": "MIT",
    "authors": [
        {
            "name": "Younes ENNAJI",
            "email": "younes.ennaji.pro@gmail.com"
        }
    ],
    "require": {
        "php": ">=8.2",
        "php-regex/regex-explain": "self.version",
        "php-regex/regex-generator": "self.version",
        "php-regex/regex-linter": "self.version",
        "php-regex/regex-optimizer": "self.version",
        "php-regex/regex-parser": "self.version",
        "php-regex/regex-redos": "self.version",
        "php-regex/regex-transpiler": "self.version"
    },
    "suggest": {
        "rector/rector": "To run the 1.x to 2.0 upgrade set in Resources/rector."
    },
    "autoload": {
        "psr-4": {
            "PHPRegex\\Toolkit\\": ""
        }
    },
    "extra": {
        "branch-alias": {
            "dev-2.x": "2.x-dev"
        }
    }
}
