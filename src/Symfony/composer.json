{
    "name": "php-regex/regex-symfony",
    "type": "symfony-bundle",
    "description": "Symfony bundle for PHPRegex: the Regex service and the regex:lint, regex:routes, regex:security, regex:analyze, regex:compare and regex:transpile commands.",
    "keywords": [
        "regex",
        "pcre",
        "symfony",
        "bundle"
    ],
    "homepage": "https://php-regex.com",
    "license": "MIT",
    "support": {
        "issues": "https://github.com/php-regex/php-regex/issues",
        "source": "https://github.com/php-regex/php-regex",
        "docs": "https://php-regex.com/guides/symfony/"
    },
    "authors": [
        {
            "name": "Younes ENNAJI",
            "email": "younes.ennaji.pro@gmail.com"
        }
    ],
    "require": {
        "php": ">=8.2",
        "symfony/config": "^7.4|^8.0",
        "symfony/console": "^7.4|^8.0",
        "symfony/dependency-injection": "^7.4|^8.0",
        "symfony/http-kernel": "^7.4|^8.0",
        "php-regex/regex-automata": "self.version",
        "php-regex/regex-linter": "self.version",
        "php-regex/regex-optimizer": "self.version",
        "php-regex/regex-parser": "self.version",
        "php-regex/regex-redos": "self.version",
        "php-regex/regex-toolkit": "self.version",
        "php-regex/regex-transpiler": "self.version"
    },
    "suggest": {
        "symfony/routing": "To analyze route requirements with regex:routes.",
        "symfony/validator": "To lint the patterns of Regex constraints.",
        "nikic/php-parser": "To extract patterns with a full PHP parser."
    },
    "autoload": {
        "psr-4": {
            "PHPRegex\\Symfony\\": ""
        }
    },
    "extra": {
        "branch-alias": {
            "dev-2.x": "2.x-dev"
        }
    }
}
