{
    "name": "php-regex/regex-mcp",
    "type": "library",
    "description": "An MCP server for coding agents: validate, explain, format, transpile and judge PCRE patterns for ReDoS, read-only, over stdio.",
    "keywords": [
        "regex",
        "pcre",
        "mcp",
        "model-context-protocol",
        "agent"
    ],
    "homepage": "https://php-regex.com",
    "license": "MIT",
    "support": {
        "issues": "https://github.com/php-regex/php-regex/issues",
        "source": "https://github.com/php-regex/php-regex",
        "docs": "https://php-regex.com/guides/mcp/"
    },
    "funding": [
        {
            "type": "github",
            "url": "https://github.com/sponsors/yoeunes"
        }
    ],
    "authors": [
        {
            "name": "Younes ENNAJI",
            "email": "younes.ennaji.pro@gmail.com",
            "homepage": "https://www.linkedin.com/in/yoeunes/",
            "role": "Developer"
        }
    ],
    "require": {
        "php": ">=8.1",
        "mcp/sdk": "^0.9",
        "php-regex/regex-parser": "self.version",
        "php-regex/regex-redos": "self.version",
        "php-regex/regex-toolkit": "self.version",
        "php-regex/regex-transpiler": "self.version",
        "psr/log": "^1.0|^2.0|^3.0"
    },
    "conflict": {
        "mcp/sdk": "<0.9"
    },
    "autoload": {
        "psr-4": {
            "PHPRegex\\Mcp\\": ""
        }
    },
    "extra": {
        "branch-alias": {
            "dev-2.x": "2.x-dev"
        }
    },
    "bin": [
        "bin/regex-mcp"
    ]
}
