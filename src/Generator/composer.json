{
    "name": "php-regex/regex-generator",
    "type": "library",
    "description": "Generates sample strings and test cases that a regex matches or rejects.",
    "keywords": [
        "regex",
        "pcre",
        "generator",
        "testing",
        "fixtures"
    ],
    "homepage": "https://github.com/php-regex/php-regex",
    "license": "MIT",
    "authors": [
        {
            "name": "Younes ENNAJI",
            "email": "younes.ennaji.pro@gmail.com"
        }
    ],
    "require": {
        "php": ">=8.2",
        "php-regex/regex-parser": "self.version"
    },
    "autoload": {
        "psr-4": {
            "PHPRegex\\Generator\\": ""
        }
    },
    "extra": {
        "branch-alias": {
            "dev-2.x": "2.x-dev"
        }
    }
}
