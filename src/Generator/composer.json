{
    "name": "php-regex/regex-generator",
    "type": "library",
    "description": "Generates sample strings and test cases that a regex matches or rejects.",
    "keywords": [
        "regex",
        "pcre",
        "generator",
        "testing",
        "fixtures"
    ],
    "homepage": "https://php-regex.com",
    "license": "MIT",
    "support": {
        "issues": "https://github.com/php-regex/php-regex/issues",
        "source": "https://github.com/php-regex/php-regex",
        "docs": "https://php-regex.com/reference/api/"
    },
    "funding": [
        {
            "type": "github",
            "url": "https://github.com/sponsors/yoeunes"
        }
    ],
    "authors": [
        {
            "name": "Younes ENNAJI",
            "email": "younes.ennaji.pro@gmail.com",
            "homepage": "https://www.linkedin.com/in/yoeunes/",
            "role": "Developer"
        }
    ],
    "require": {
        "php": ">=8.1",
        "ext-mbstring": "*",
        "php-regex/regex-parser": "self.version"
    },
    "autoload": {
        "psr-4": {
            "PHPRegex\\Generator\\": ""
        }
    },
    "extra": {
        "branch-alias": {
            "dev-2.x": "2.x-dev"
        }
    }
}
