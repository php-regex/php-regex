{
    "name": "php-regex/regex-language-server",
    "type": "library",
    "description": "A Language Server for the regex patterns of PHP files: diagnostics, hovers, completions and code actions in any LSP editor.",
    "keywords": [
        "regex",
        "pcre",
        "lsp",
        "language-server",
        "editor"
    ],
    "homepage": "https://github.com/php-regex/php-regex",
    "license": "MIT",
    "authors": [
        {
            "name": "Younes ENNAJI",
            "email": "younes.ennaji.pro@gmail.com"
        }
    ],
    "require": {
        "php": ">=8.2",
        "php-regex/regex-explain": "^2.0",
        "php-regex/regex-linter": "^2.0",
        "php-regex/regex-parser": "^2.0",
        "php-regex/regex-toolkit": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "PHPRegex\\LanguageServer\\": ""
        }
    },
    "extra": {
        "branch-alias": {
            "dev-2.x": "2.x-dev"
        }
    },
    "bin": [
        "bin/regex-lsp"
    ]
}
