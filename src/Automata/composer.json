{
    "name": "php-regex/automata",
    "type": "library",
    "description": "Compiles the regular subset of PCRE to automata to compare languages: equivalence, intersection, subset and example strings.",
    "keywords": [
        "regex",
        "automata",
        "dfa",
        "nfa",
        "equivalence"
    ],
    "homepage": "https://github.com/php-regex/php-regex",
    "license": "MIT",
    "authors": [
        {
            "name": "Younes ENNAJI",
            "email": "younes.ennaji.pro@gmail.com"
        }
    ],
    "require": {
        "php": ">=8.2",
        "php-regex/parser": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "PHPRegex\\Automata\\": ""
        }
    },
    "extra": {
        "branch-alias": {
            "dev-2.x": "2.x-dev"
        }
    }
}
