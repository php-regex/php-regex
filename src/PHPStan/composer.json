{
    "name": "php-regex/phpstan",
    "type": "phpstan-extension",
    "description": "PHPStan extension that reports the regex patterns your target PHP refuses, and, opt-in, lint and ReDoS findings.",
    "keywords": [
        "regex",
        "pcre",
        "phpstan",
        "static-analysis"
    ],
    "homepage": "https://github.com/php-regex/php-regex",
    "license": "MIT",
    "authors": [
        {
            "name": "Younes ENNAJI",
            "email": "younes.ennaji.pro@gmail.com"
        }
    ],
    "require": {
        "php": ">=8.2",
        "phpstan/phpstan": "^2.0",
        "php-regex/linter": "^2.0",
        "php-regex/optimizer": "^2.0",
        "php-regex/parser": "^2.0",
        "php-regex/redos": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "PHPRegex\\PHPStan\\": ""
        }
    },
    "extra": {
        "branch-alias": {
            "dev-2.x": "2.x-dev"
        },
        "phpstan": {
            "includes": [
                "extension.neon"
            ]
        }
    }
}
