parametersSchema:
    phpRegex: structure([
        # PHP version patterns are judged for: null for PHPStan's phpVersion
        # (the PHP running PHPStan unless configured), 'runtime' for the PHP
        # running PHPStan, a version like '8.2' or a PHP_VERSION_ID like 80200
        phpVersion: schema(anyOf(schema(string(), pattern('runtime|\d{5,}|\d+\.\d{1,2}(\.\d{1,2})?')), schema(int(), min(1))), nullable()),
        # PCRE2 release patterns are judged for, like '10.42' or PCRE_VERSION
        # ('10.44 2024-06-07'), used as is; null for the one composer.json
        # pins in config.platform.lib-pcre, else the running PCRE2 for the
        # running PHP's minor version, else the one the PHP version bundles
        pcreVersion: schema(string(), pattern('\d+\.\d+(-[A-Za-z0-9]+)?(\s.*)?'), nullable()),
        # LC_CTYPE locale patterns are judged under, like 'tr_TR.UTF-8':
        # its character tables decide the size of some classes; null for
        # the locale of the PHP running PHPStan
        locale: schema(string(), nullable()),
        # Libraries whose static methods carry a pattern, as the lint's
        # extraction.interop; null for every preset, [] for the native
        # functions only. A name that is no preset stops the analysis when
        # the rule is built, naming the preset it most likely means: left
        # out, it would leave a list that reads fewer calls than meant
        interop: schema(listOf(string()), nullable()),
        checks: structure([
            lint: structure([
                enabled: bool()
            ]),
            redos: structure([
                enabled: bool(),
                # Minimum severity reported
                threshold: anyOf('low', 'medium', 'high', 'critical')
            ]),
            optimizations: structure([
                enabled: bool(),
                minSavings: int(),
                options: structure([
                    digits: bool(),
                    word: bool(),
                    ranges: bool(),
                    canonicalizeCharClasses: bool(),
                    possessive: bool(),
                    factorize: bool(),
                    minQuantifierCount: int(),
                    verifyWithAutomata: bool()
                ])
            ]),
            complexity: structure([
                enabled: bool(),
                # The complexity score from which a pattern is reported
                threshold: schema(int(), min(1))
            ])
        ])
    ])

parameters:
    # Keeps what the engine answers about Unicode classes under tmpDir, for
    # the next run and the other workers: PHPStan runs it once in each
    # process.
    bootstrapFiles:
        - bootstrap.php

    phpRegex:
        # Judge patterns for PHPStan's phpVersion, with the PCRE2 the running
        # PHP links when it is that minor version, else the one it bundles.
        # A pattern is reported only when the running engine compiles it and
        # the target refuses it: PHPStan itself reports what the running
        # engine refuses.
        phpVersion: null
        pcreVersion: null
        locale: null
        interop: null

        # Off by default; rules.neon turns lint and ReDoS on, and leaves
        # optimizations and complexity off.
        checks:
            lint:
                enabled: false
            redos:
                enabled: false
                # High, as regex lint, the Symfony and Laravel bridges and
                # the language server report from.
                threshold: high
            optimizations:
                enabled: false
                minSavings: 1
                options:
                    digits: true
                    word: true
                    ranges: true
                    canonicalizeCharClasses: true
                    possessive: false
                    factorize: false
                    minQuantifierCount: 4
                    verifyWithAutomata: true
            complexity:
                enabled: false
                threshold: 50

services:
    -
        class: PHPRegex\PHPStan\RegexPatternRule
        arguments:
            config: %phpRegex%
            # PHPStan's own phpVersion: with {min, max}, each later PHP of
            # the range validates the patterns too.
            phpVersionRange: %phpVersion%
        tags:
            - phpstan.rules.rule
    -
        # The "@regex-target" markers that cannot be read, or keep no
        # version of the range.
        class: PHPRegex\PHPStan\RegexTargetMarkerRule
        arguments:
            config: %phpRegex%
            phpVersionRange: %phpVersion%
        tags:
            - phpstan.rules.rule
    -
        # The patterns passed to a parameter marked #[RegexPattern] or
        # #[Language('RegExp')], checked alike.
        class: PHPRegex\PHPStan\RegexPatternArgumentRule
        arguments:
            config: %phpRegex%
            phpVersionRange: %phpVersion%
        tags:
            - phpstan.rules.rule
