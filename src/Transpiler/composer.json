{
    "name": "php-regex/regex-transpiler",
    "type": "library",
    "description": "Transpiles PCRE patterns to JavaScript and Python regular expressions, with the losses reported.",
    "keywords": [
        "regex",
        "pcre",
        "transpiler",
        "javascript",
        "python"
    ],
    "homepage": "https://github.com/php-regex/php-regex",
    "license": "MIT",
    "authors": [
        {
            "name": "Younes ENNAJI",
            "email": "younes.ennaji.pro@gmail.com"
        }
    ],
    "require": {
        "php": ">=8.2",
        "php-regex/regex-parser": "self.version"
    },
    "autoload": {
        "psr-4": {
            "PHPRegex\\Transpiler\\": ""
        }
    },
    "extra": {
        "branch-alias": {
            "dev-2.x": "2.x-dev"
        }
    }
}
