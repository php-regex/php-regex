{
    "name": "php-regex/regex-optimizer",
    "type": "library",
    "description": "Rewrites regex patterns into shorter equivalents and modernizes old syntax; equivalence can be proven, opt-in, by regex-automata.",
    "keywords": [
        "regex",
        "pcre",
        "optimizer",
        "refactoring"
    ],
    "homepage": "https://github.com/php-regex/php-regex",
    "license": "MIT",
    "authors": [
        {
            "name": "Younes ENNAJI",
            "email": "younes.ennaji.pro@gmail.com"
        }
    ],
    "require": {
        "php": ">=8.2",
        "php-regex/regex-automata": "self.version",
        "php-regex/regex-parser": "self.version",
        "php-regex/regex-redos": "self.version"
    },
    "autoload": {
        "psr-4": {
            "PHPRegex\\Optimizer\\": ""
        }
    },
    "extra": {
        "branch-alias": {
            "dev-2.x": "2.x-dev"
        }
    }
}
