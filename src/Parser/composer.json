{
    "name": "php-regex/regex-parser",
    "type": "library",
    "description": "The PCRE2 regex parser: lexer, immutable AST, validator that answers as PHP's PCRE2 would for a chosen release, AST cache and the small AST analyses.",
    "keywords": [
        "regex",
        "pcre",
        "pcre2",
        "parser",
        "ast",
        "lexer",
        "validation"
    ],
    "homepage": "https://php-regex.com",
    "license": "MIT",
    "support": {
        "issues": "https://github.com/php-regex/php-regex/issues",
        "source": "https://github.com/php-regex/php-regex",
        "docs": "https://php-regex.com/reference/api/"
    },
    "funding": [
        {
            "type": "github",
            "url": "https://github.com/sponsors/yoeunes"
        }
    ],
    "authors": [
        {
            "name": "Younes ENNAJI",
            "email": "younes.ennaji.pro@gmail.com",
            "homepage": "https://www.linkedin.com/in/yoeunes/",
            "role": "Developer"
        }
    ],
    "require": {
        "php": ">=8.1",
        "ext-mbstring": "*"
    },
    "suggest": {
        "psr/cache": "To share the AST cache through a PSR-6 pool.",
        "psr/simple-cache": "To share the AST cache through a PSR-16 cache.",
        "ext-intl": "To resolve \\N{name} escapes by Unicode name.",
        "ext-posix": "To check that the cache directory belongs to the running user."
    },
    "autoload": {
        "psr-4": {
            "PHPRegex\\Parser\\": ""
        }
    },
    "extra": {
        "branch-alias": {
            "dev-2.x": "2.x-dev"
        }
    }
}
