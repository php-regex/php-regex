{
    "an unscoped (?-x) inside a group": "/^(?:alpha(?-x) b c (?:dd|ee) f|gamma)$/",
    "an unscoped (?^) inside a group under x": "/^(?:alpha(?^) b c (?:dd|ee) f|gamma)(?:x|y)$/x",
    "a scoped (?-x:...)": "/^(?i:alpha(?-x: b c )(?:dd|ee))(?:x|y)$/",
    "a quoted run with a space and a hash": "/^(?:\\Q a # b \\E|c)(?:d|e)$/",
    "control-space and control-hash": "/^(?:a\\c |b\\c#)(?:d|e)$/",
    "a raw tab and line feed in a class": "/^(?:[\t\n ]|#)(?:d|e)$/",
    "group names and named references": "/^(?:(?<n>a)\\k<n>|(?P<m>b)(?P=m)|(?'o'c)\\k{o})$/",
    "a branch reset": "/^(?|(a)|(b))\\1(?:c|d)$/",
    "conditionals on an assertion, a number, a name and recursion": "/^(?(?=a)ab|cd)(?(1)x|y)(?(<n>)z)(?(R)w)(?<n>q)$/",
    "DEFINE and subroutine calls": "/(?(DEFINE)(?<a>aa)(?<b>bb))^(?&a)(?&b)+$/",
    "atomic groups and lookarounds": "/^(?>a+)(?=b)(?!c)(?<=b)(?<!d)(?*e)?$/",
    "(*UTF)(*UCP) with non-ASCII letters": "/(*UTF)(*UCP)^(?:é|ü)\\w+$/",
    "(*LIMIT_MATCH=1000)": "/(*LIMIT_MATCH=1000)^(?:a|b)+$/",
    "quantifier spellings": "/^(?:a{2,3}|b{,4}|c{5,})\\d{2}$/",
    "escape spellings under u": "/^(?:\\x{41}|\\101|\\o{102}|\\N{U+43})$/u",
    "a backreference before a digit under x": "/^(a)(b)(c)(d)(e)(f)(g)(h)(i)(j)\\1 0\\10(?:x|y)$/x",
    "the hash delimiter with an escaped hash": "#^(?:http|ftp)://[^\\#/]+(?:/[^\\#]*)?(?:\\#.*)?$#",
    "the brace delimiter": "{^(?:a|b)\\{2\\}(?:c|d)$}",
    "the parenthesis delimiter": "(^(?:a|b)(?:c|d)$)",
    "an inline (?n)": "/^(?n)(a)(?<k>b)(?:c|d)\\k<k>$/",
    "Unicode properties, POSIX classes and escapes": "/^\\p{Lu}\\P{Ll}[[:alpha:][:^digit:]]\\X\\R\\h\\v(?:a|b)$/u",
    "backtracking verbs": "/^(?:a(*SKIP)(*FAIL)|b(*PRUNE)c|(*COMMIT)d)(*ACCEPT)?$/",
    "deeply nested alternations": "/^(?:a|(?:b|(?:c|(?:d|(?:e|(?:f|g))))))$/",
    "callouts": "/^a(?C1)b(?C\"x\")c(?:d|e)$/",
    "an inline (?x)": "/^(?x) a b (?:c | d) $/",
    "an escaped space before a group": "/^a\\ (?:b|c)$/",
    "a space before a group": "/^a (?:b|c)$/",
    "a comment between an atom and its quantifier": "/^(?:a # c\n +|b)$/x",
    "a comment between a quantifier and its modifier": "/^(?:a+ # c\n ?b|c)$/x",
    "a comment inside a brace": "/^a{(?#c),2}(?:b|c)$/",
    "comments under (*CR)": "/(*CR)^(?:alpha|beta)(?:gamma|delta)$ # c/x",
    "a spaced quantifier without x": "/^a{ 1,2 }(?:b|c)$/",
    "a top-level (?-x)": "/^a(?-x) b (?:c|d)$/x",
    "byte 0x85 inside a UTF-8 sequence in byte mode": "/^(?:Å|b)c$/",
    "NEL, LRM and NBSP under u": "/^(?:ab|c‎d|e f)$/u",
    "a complete octal escape before a digit under x": "/^\\000 0(?:a|b)$/x",
    "the empty pattern": "//",
    "a lone comment": "/#/x",
    "an empty first and last branch": "/^(?:|a|b|)(?:c|)$/"
}
