    "regex_transpile": {
        "title": "Translate a regex pattern to JavaScript, HTML or Python",
        "description": "A PCRE pattern written as in PHP source (/…/flags) rewritten for JavaScript (js), an HTML pattern attribute (html) or Python (python), with every note on what was rewritten and every warning on what matches differently. A construct the dialect cannot express is refused with its reason, never approximated.",
        "inputSchema": {
            "type": "object",
            "properties": {
                "pattern": {
                    "type": "string",
                    "description": "The pattern as written in PHP source, delimiters and flags included, as /^\\d+$/i. The delimiters are required."
                },
                "target": {
                    "type": "string",
                    "enum": [
                        "js",
                        "html",
                        "python"
                    ],
                    "description": "The dialect: js, html or python."
                },
                "python_version": {
                    "type": "string",
                    "description": "The Python release the pattern runs on, as \"3.11\", which carries atomic groups."
                },
                "php_version": {
                    "type": "string",
                    "description": "The PHP release to judge for, as \"8.2\". Default: the server's target, else the running PHP."
                },
                "pcre_version": {
                    "type": "string",
                    "description": "The PCRE2 release to judge for, as \"10.44\". Default: the one the PHP release bundles."
                }
            },
            "required": [
                "pattern",
                "target"
            ],
            "additionalProperties": false
        },
        "outputSchema": {
            "oneOf": [
                {
                    "type": "object",
                    "properties": {
