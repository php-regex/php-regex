    "regex_format": {
        "title": "Lay a regex pattern out, or compact it",
        "description": "A PCRE pattern written as in PHP source (/…/flags) laid out over lines under the x flag at the width given, or compacted to one line; the result matches exactly what the pattern given matches. A pattern that cannot be laid out safely is given back as written, with the reason.",
        "inputSchema": {
            "type": "object",
            "properties": {
                "pattern": {
                    "type": "string",
                    "description": "The pattern as written in PHP source, delimiters and flags included, as /^\\d+$/i. The delimiters are required."
                },
                "width": {
                    "type": "integer",
                    "minimum": 1,
                    "description": "The width a line aims at, indent included. Default 80."
                },
                "compact": {
                    "type": "boolean",
                    "description": "Write the pattern on one line, without x, layout or comments. Default false."
                },
                "php_version": {
                    "type": "string",
                    "description": "The PHP release to judge for, as \"8.2\". Default: the server's target, else the running PHP."
                },
                "pcre_version": {
                    "type": "string",
                    "description": "The PCRE2 release to judge for, as \"10.44\". Default: the one the PHP release bundles."
                }
            },
            "required": [
                "pattern"
            ],
            "additionalProperties": false
        },
        "outputSchema": {
            "oneOf": [
                {
                    "type": "object",
                    "properties": {
                        "pattern": {
                            "type": "string"
                        },
                        "formatted": {
                            "type": "string"
                        },
                        "changed": {
                            "type": "boolean"
                        },
                        "refusal": {
