    "regex_redos": {
        "title": "Judge a regex pattern for ReDoS",
        "description": "The ReDoS verdict on a PCRE pattern written as in PHP source (/…/flags): severity, complexity, the witness input that pumps the backtracking, the hotspots in the pattern and the recommendations. In confirmed mode the pattern is run on this machine against crafted inputs, under the library's own caps, to prove the verdict.",
        "inputSchema": {
            "type": "object",
            "properties": {
                "pattern": {
                    "type": "string",
                    "description": "The pattern as written in PHP source, delimiters and flags included, as /^\\d+$/i. The delimiters are required."
                },
                "mode": {
                    "type": "string",
                    "enum": [
                        "theoretical",
                        "confirmed"
                    ],
                    "description": "theoretical (default) reads the pattern; confirmed also replays the witness through the engine on this machine, bounded by the library's caps."
                },
                "threshold": {
                    "type": "string",
                    "enum": [
                        "low",
                        "medium",
                        "high",
                        "critical"
                    ],
                    "description": "The lowest severity confirmed mode replays."
                },
                "php_version": {
                    "type": "string",
                    "description": "The PHP release to judge for, as \"8.2\". Default: the server's target, else the running PHP."
                },
                "pcre_version": {
                    "type": "string",
                    "description": "The PCRE2 release to judge for, as \"10.44\". Default: the one the PHP release bundles."
                }
            },
            "required": [
                "pattern"
            ],
            "additionalProperties": false
        },
        "outputSchema": {
            "oneOf": [
                {
                    "type": "object",
                    "properties": {
                        "pattern": {
                            "type": "string"
                        },
