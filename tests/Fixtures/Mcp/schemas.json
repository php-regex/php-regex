{
    "regex_validate": {
        "title": "Validate a regex pattern",
        "description": "Whether the target PHP compiles a PCRE pattern written as in PHP source (/…/flags, delimiters included): the verdict, the error with its byte offset, and a hint. An invalid pattern is the answer, not a failure.",
        "inputSchema": {
            "type": "object",
            "properties": {
                "pattern": {
                    "type": "string",
                    "description": "The pattern as written in PHP source, delimiters and flags included, as /^\\d+$/i. The delimiters are required."
                },
                "php_version": {
                    "type": "string",
                    "description": "The PHP release to judge for, as \"8.2\". Default: the server's target, else the running PHP."
                },
                "pcre_version": {
                    "type": "string",
                    "description": "The PCRE2 release to judge for, as \"10.44\". Default: the one the PHP release bundles."
                }
            },
            "required": [
                "pattern"
            ],
            "additionalProperties": false
        },
        "outputSchema": {
            "oneOf": [
                {
                    "type": "object",
                    "properties": {
                        "pattern": {
                            "type": "string"
                        },
                        "validation": {
                            "type": "object",
                            "properties": {
                                "is_valid": {
                                    "type": "boolean"
                                },
                                "error": {
                                    "type": [
                                        "string",
                                        "null"
                                    ]
                                },
                                "complexity_score": {
                                    "type": "integer"
                                },
                                "category": {
                                    "type": [
                                        "string",
                                        "null"
                                    ]
                                },
                                "offset": {
                                    "type": [
                                        "integer",
                                        "null"
                                    ]
                                },
                                "caret_snippet": {
                                    "type": [
                                        "string",
                                        "null"
                                    ]
                                },
                                "hint": {
                                    "type": [
                                        "string",
                                        "null"
                                    ]
                                },
                                "error_code": {
                                    "type": [
                                        "string",
                                        "null"
                                    ]
                                }
                            },
                            "required": [
                                "is_valid",
                                "error",
                                "complexity_score",
                                "category",
                                "offset",
                                "caret_snippet",
                                "hint",
