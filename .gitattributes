# Git Attributes Configuration
# https://git-scm.com/docs/gitattributes

# Normalize line endings to LF for all text files
* text=auto eol=lf

# Vendored PCRE2 testdata: byte-exact copies of the upstream files (stray CR
# bytes are pattern data), never normalized
/tests/Fixtures/Pcre2/testdata/** -text

# Export-ignore patterns (for composer archive)
# Development and CI/CD files
/.github                export-ignore

# Configuration files
/.editorconfig          export-ignore
/.gitattributes         export-ignore
/.gitignore             export-ignore
/.php-cs-fixer.dist.php export-ignore
/.php-cs-fixer.cache    export-ignore
/.phplint.yml           export-ignore
/.php-version           export-ignore
/.gitmessage            export-ignore

# Development tools and configs
/bin/php-cs-fixer       export-ignore
/bin/phpbench           export-ignore
/bin/phpcs              export-ignore
/bin/phplint            export-ignore
/bin/phpstan            export-ignore
/bin/rector             export-ignore
/bin/phpunit            export-ignore
/bin/infection          export-ignore
/bin/redos-bench        export-ignore
/bin/regex              export-ignore
/bin/regex-lsp          export-ignore
/bin/split              export-ignore
/bin/bump               export-ignore
/bin/release            export-ignore
/bin/status             export-ignore
/bin/corpus             export-ignore
/phpbench.json          export-ignore
/phpstan.dist.neon      export-ignore
/deptrac.yaml           export-ignore
/rector.php             export-ignore
/phpunit.xml.dist       export-ignore
/infection.json.dist    export-ignore
/taskfile.dist.yaml     export-ignore
/box.json               export-ignore
/phpstan-baseline.neon  export-ignore

# Development documentation
/CODE_OF_CONDUCT.md     export-ignore
/CONTRIBUTING.md        export-ignore
/SECURITY.md            export-ignore
/TODO.md                export-ignore

# Directories not needed in distribution
/art                    export-ignore
/corpus                 export-ignore
/corpus.json            export-ignore
/var                    export-ignore
/docs                   export-ignore
/tests                  export-ignore
/tools                  export-ignore
/.task                  export-ignore
/.cache                 export-ignore
/examples               export-ignore
/phar                   export-ignore

# Additional files not needed in distribution
/bin/build              export-ignore
/bin/regex.phar         export-ignore
/regex.dist.json        export-ignore

# PHP files
*.php text eol=lf diff=php
