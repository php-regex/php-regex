<?xml version="1.0" encoding="UTF-8"?>
<!--
    The suite on PHP 8.1, where PHPUnit 12 does not run: PHPUnit 10.5 runs it,
    the Symfony bridge on Symfony 6.4 and the Laravel one on Laravel 10. A row
    PHP 8.1 cannot run, such as a pattern with the n modifier or a NUL byte,
    is gated on PHP 8.2.
-->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         backupGlobals="false"
         colors="true"
         bootstrap="../../tests/bootstrap.php"
         cacheDirectory="../../.cache/phpunit-81/"
         executionOrder="random"
         displayDetailsOnIncompleteTests="true"
         displayDetailsOnSkippedTests="true"
         displayDetailsOnTestsThatTriggerDeprecations="true"
         displayDetailsOnTestsThatTriggerErrors="true"
         displayDetailsOnTestsThatTriggerNotices="true"
         displayDetailsOnTestsThatTriggerWarnings="true"
         resolveDependencies="true">
    <php>
        <ini name="memory_limit" value="-1"/>
        <ini name="error_reporting" value="-1"/>
        <ini name="display_errors" value="stderr"/>
        <ini name="log_errors" value="true"/>
        <ini name="serialize_precision" value="-1"/>
    </php>
    <extensions>
        <!-- The same deprecation policy as the PHPUnit 12 run: a
             deprecation under src/ fails, vendor ones stay
             informational. PHPUnit 10.5 carries the same event types. -->
        <bootstrap class="PHPRegex\Tests\Support\SourceDeprecationListener"/>
        <!-- The directory the class scans are kept in is set for the
             whole process: each test leaves it unset for the next. -->
        <bootstrap class="PHPRegex\Tests\Support\ClassSetStoreReset"/>
    </extensions>
    <testsuites>
        <testsuite name="PHPRegex on PHP 8.1">
            <directory>../../tests</directory>
            <!-- The benchmarks run under phpbench, not PHPUnit. -->
            <exclude>../../tests/Benchmark</exclude>
        </testsuite>
    </testsuites>

    <groups>
        <exclude>
            <group>capture-shape-parity</group>
            <group>formatter-corpus</group>
        </exclude>
    </groups>
</phpunit>
