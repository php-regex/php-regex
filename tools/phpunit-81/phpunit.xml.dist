<?xml version="1.0" encoding="UTF-8"?>
<!--
    The suite on PHP 8.1, where PHPUnit 12 does not run: PHPUnit 10.5 runs it.
    By default, the directories that hold on PHP 8.1; the whole tree, but the
    Symfony and Laravel bridges, with the suite named all. Most of what fails
    there writes the n modifier or a NUL byte into a pattern, which PHP 8.1
    refuses, or calls a PHPUnit 11 assertion.
-->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         backupGlobals="false"
         colors="true"
         bootstrap="bootstrap.php"
         defaultTestSuite="php81"
         cacheDirectory="../../.cache/phpunit-81/"
         executionOrder="random"
         displayDetailsOnIncompleteTests="true"
         displayDetailsOnSkippedTests="true"
         displayDetailsOnTestsThatTriggerDeprecations="true"
         displayDetailsOnTestsThatTriggerErrors="true"
         displayDetailsOnTestsThatTriggerNotices="true"
         displayDetailsOnTestsThatTriggerWarnings="true"
         resolveDependencies="true">
    <php>
        <ini name="memory_limit" value="-1"/>
        <ini name="error_reporting" value="-1"/>
        <ini name="display_errors" value="stderr"/>
        <ini name="log_errors" value="true"/>
        <ini name="serialize_precision" value="-1"/>
    </php>
    <testsuites>
        <testsuite name="all">
            <directory>../../tests</directory>
            <!-- Laravel 12 and Symfony 7.4 need PHP 8.2, as their bridges do. -->
            <exclude>../../tests/Integration/Bridge/Laravel</exclude>
            <exclude>../../tests/Integration/Bridge/Symfony</exclude>
            <exclude>../../tests/Unit/Bridge/Laravel</exclude>
            <exclude>../../tests/Unit/Bridge/Symfony</exclude>
            <exclude>../../tests/Integration/SymfonyCompatibilityTest.php</exclude>
            <exclude>../../tests/Integration/SymfonyIntegrationTest.php</exclude>
            <!-- The benchmarks run under phpbench, not PHPUnit. -->
            <exclude>../../tests/Benchmark</exclude>
        </testsuite>
        <testsuite name="php81">
            <directory>../../tests/Documentation</directory>
            <directory>../../tests/Functional/Regression</directory>
            <directory>../../tests/Integration/Cli</directory>
            <directory>../../tests/Integration/Lint</directory>
            <directory>../../tests/Integration/PatternInfo</directory>
            <directory>../../tests/Integration/Sweep</directory>
            <directory>../../tests/Unit/Api</directory>
            <directory>../../tests/Unit/Bridge/PHPStan</directory>
            <directory>../../tests/Unit/Cli</directory>
            <directory>../../tests/Unit/Corpus</directory>
            <directory>../../tests/Unit/Engine</directory>
            <directory>../../tests/Unit/Exception</directory>
            <directory>../../tests/Unit/Generator</directory>
            <directory>../../tests/Unit/Hir</directory>
            <directory>../../tests/Unit/Lexer</directory>
            <directory>../../tests/Unit/Linter</directory>
            <directory>../../tests/Unit/Lsp</directory>
            <directory>../../tests/Unit/Node</directory>
            <directory>../../tests/Unit/Optimizer</directory>
            <directory>../../tests/Unit/Packages</directory>
            <directory>../../tests/Unit/Release</directory>
            <directory>../../tests/Unit/Runtime</directory>
            <directory>../../tests/Unit/Support</directory>
            <directory>../../tests/Unit/TestUtils</directory>
            <directory>../../tests/Unit/Tools</directory>
            <directory>../../tests/Unit/Transpiler</directory>
            <directory>../../tests/Unit/Traversal</directory>
            <directory>../../tests/Unit/Validator</directory>
            <directory>../../tests/Unit/Visitor</directory>
            <directory>../../tests/Unit/Automata</directory>
            <directory>../../tests/Integration/Bridge/PHPStan</directory>
            <exclude>../../tests/Integration/Bridge/PHPStan/CaptureShapePhpStanTypeTest.php</exclude>
        </testsuite>
    </testsuites>

    <groups>
        <exclude>
            <group>capture-shape-parity</group>
            <group>formatter-corpus</group>
        </exclude>
    </groups>
</phpunit>
