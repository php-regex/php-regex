{
    "name": "php-regex/php-regex",
    "description": "Static analysis for PHP regular expressions: parse, validate, explain, prove ReDoS safety, lint, optimize and compare patterns, with PHPStan, Psalm, Rector, Symfony and Laravel integrations.",
    "keywords": ["regex", "pcre", "parser", "ast", "validation", "redos", "security", "linter", "static-analysis", "automata", "phpstan", "psalm", "rector", "symfony", "laravel", "cli"],
    "homepage": "https://php-regex.com",
    "type": "library",
    "license": "MIT",
    "support": {
        "issues": "https://github.com/php-regex/php-regex/issues",
        "source": "https://github.com/php-regex/php-regex",
        "docs": "https://php-regex.com/docs/"
    },
    "funding": [
        {
            "type": "github",
            "url": "https://github.com/sponsors/yoeunes"
        }
    ],
    "authors": [
        {
            "name": "Younes ENNAJI",
            "email": "younes.ennaji.pro@gmail.com",
            "homepage": "https://www.linkedin.com/in/yoeunes/",
            "role": "Developer"
        }
    ],
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": ">=8.1",
        "ext-mbstring": "*",
        "ext-tokenizer": "*"
    },
    "replace": {
        "php-regex/regex-automata": "self.version",
        "php-regex/regex-cli": "self.version",
        "php-regex/regex-explain": "self.version",
        "php-regex/regex-generator": "self.version",
        "php-regex/regex-language-server": "self.version",
        "php-regex/regex-laravel": "self.version",
        "php-regex/regex-linter": "self.version",
        "php-regex/regex-optimizer": "self.version",
        "php-regex/regex-parser": "self.version",
        "php-regex/regex-phpstan": "self.version",
        "php-regex/regex-phpunit": "self.version",
        "php-regex/regex-psalm": "self.version",
        "php-regex/regex-rector": "self.version",
        "php-regex/regex-redos": "self.version",
        "php-regex/regex-symfony": "self.version",
        "php-regex/regex-toolkit": "self.version",
        "php-regex/regex-transpiler": "self.version"
    },
    "autoload": {
        "psr-4": {
            "PHPRegex\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "PHPRegex\\Tests\\": "tests/"
        },
        "exclude-from-classmap": [
            "tests/Benchmark/Fixtures/",
            "tests/Fixtures/",
            "tests/Integration/Bridge/PHPStan/Fixtures/",
            "tests/Integration/Bridge/Psalm/Fixtures/",
            "tests/Integration/Bridge/Rector/**/Fixture/",
            "tests/Integration/Bridge/Rector/**/Fixture*/"
        ]
    },
    "bin": [
        "src/Cli/bin/regex",
        "src/LanguageServer/bin/regex-lsp"
    ],
    "scripts": {
        "phpunit": "tools/phpunit/vendor/bin/phpunit",
        "test:parallel": "php -d phar.readonly=0 tools/paratest/vendor/bin/paratest --passthru-php=\"'-d' 'phar.readonly=0'\"",
        "phpstan": "tools/phpstan/vendor/bin/phpstan analyse",
        "rector": "tools/rector/vendor/bin/rector process",
        "phpcs": "tools/php-cs-fixer/vendor/bin/php-cs-fixer fix",
        "phplint": "tools/phplint/vendor/bin/phplint",
        "bench": "tools/phpbench/vendor/bin/phpbench run",
        "cache-version": "php tests/Tools/update_cache_version.php",
        "infection": "tools/infection/vendor/bin/infection",
        "deptrac": "tools/deptrac/vendor/bin/deptrac analyse --config-file=deptrac.yaml --no-progress",
        "lint": [
            "@rector",
            "@phpcs",
            "@cache-version",
            "@phplint",
            "@phpunit",
            "@phpstan",
            "@deptrac"
        ]
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "extra": {
        "branch-alias": {
            "dev-2.x": "2.x-dev"
        },
        "laravel": {
            "providers": [
                "PHPRegex\\Laravel\\PHPRegexServiceProvider"
            ],
            "aliases": {
                "Regex": "PHPRegex\\Laravel\\Facades\\Regex"
            }
        },
        "phpstan": {
            "includes": [
                "src/PHPStan/extension.neon"
            ]
        },
        "psalm": {
            "pluginClass": "PHPRegex\\Psalm\\Plugin"
        }
    },
    "conflict": {
        "illuminate/console": "<10.37",
        "illuminate/contracts": "<10.37",
        "illuminate/routing": "<10.37",
        "illuminate/support": "<10.37",
        "nikic/php-parser": "<4.18",
        "phpstan/phpstan": "<2.0",
        "phpunit/phpunit": "<9.6",
        "rector/rector": "<2.4",
        "symfony/config": "<6.4",
        "symfony/console": "<6.4",
        "symfony/dependency-injection": "<6.4",
        "symfony/http-kernel": "<6.4",
        "vimeo/psalm": "<6.19"
    },
    "suggest": {
        "ext-intl": "To resolve \\N{...} escapes by Unicode name.",
        "ext-pcntl": "To lint in parallel worker processes.",
        "ext-posix": "For TTY detection and worker signaling.",
        "illuminate/console": "Required for Laravel Artisan commands.",
        "illuminate/contracts": "Required for Laravel integration.",
        "illuminate/routing": "Required for Laravel route analysis.",
        "illuminate/support": "Required for Laravel integration.",
        "nikic/php-parser": "To extract regex patterns from PHP sources with a real parser instead of the tokenizer.",
        "phpstan/extension-installer": "To automatically enable the PHPStan rule for regex validation.",
        "phpstan/phpstan": "To run static analysis and detect invalid regex patterns.",
        "phpunit/phpunit": "To assert on regex patterns in your test suite (php-regex/regex-phpunit).",
        "psr/cache": "To share AST cache via PSR-6 pools.",
        "psr/simple-cache": "To share AST cache via PSR-16 caches.",
        "rector/rector": "To rewrite preg_* calls into the string functions the automata prove they match.",
        "symfony/routing": "To analyze route requirements with regex:routes.",
        "symfony/validator": "To lint the patterns of Regex constraints, and to validate submitted patterns with ValidRegex.",
        "symfony/yaml": "To read a security file named with regex:security --config or regex:analyze --config.",
        "vimeo/psalm": "To type $matches from the pattern and report invalid patterns in Psalm (php-regex/regex-psalm)."
    }
}
