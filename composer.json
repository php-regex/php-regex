{
    "name": "yoeunes/regex-parser",
    "description": "A PCRE regex parser with lexer, AST builder, validation, ReDoS analysis, and syntax highlighting. Zero runtime dependencies.",
    "keywords": ["regex", "parser", "pcre", "lexer", "ast", "validation", "redos", "security", "syntax-highlighting", "php", "cli"],
    "homepage": "https://github.com/php-regex/regex-parser",
    "type": "library",
    "license": "MIT",
    "support": {
        "issues": "https://github.com/php-regex/regex-parser/issues",
        "source": "https://github.com/php-regex/regex-parser",
        "docs": "https://github.com/php-regex/regex-parser#readme"
    },
    "funding": [
        {
            "type": "github",
            "url": "https://github.com/sponsors/yoeunes"
        }
    ],
    "authors": [
        {
            "name": "Younes ENNAJI",
            "email": "younes.ennaji.pro@gmail.com",
            "homepage": "https://www.linkedin.com/in/yoeunes/",
            "role": "Developer"
        }
    ],
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": ">=8.2",
        "ext-mbstring": "*"
    },
    "replace": {
        "php-regex/automata": "self.version",
        "php-regex/cli": "self.version",
        "php-regex/explain": "self.version",
        "php-regex/generator": "self.version",
        "php-regex/language-server": "self.version",
        "php-regex/laravel": "self.version",
        "php-regex/linter": "self.version",
        "php-regex/optimizer": "self.version",
        "php-regex/parser": "self.version",
        "php-regex/phpstan": "self.version",
        "php-regex/redos": "self.version",
        "php-regex/symfony": "self.version",
        "php-regex/toolkit": "self.version",
        "php-regex/transpiler": "self.version"
    },
    "autoload": {
        "psr-4": {
            "PHPRegex\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "PHPRegex\\Tests\\": "tests/"
        },
        "exclude-from-classmap": [
            "tests/Fixtures/"
        ]
    },
    "bin": [
        "bin/regex",
        "bin/regex-lsp"
    ],
    "scripts": {
        "phpunit": "tools/phpunit/vendor/bin/phpunit",
        "phpstan": "tools/phpstan/vendor/bin/phpstan analyse",
        "rector": "tools/rector/vendor/bin/rector process",
        "phpcs": "tools/php-cs-fixer/vendor/bin/php-cs-fixer fix",
        "phplint": "tools/phplint/vendor/bin/phplint",
        "bench": "tools/phpbench/vendor/bin/phpbench run",
        "cache-version": "php tests/Tools/update_cache_version.php",
        "infection": "tools/infection/vendor/bin/infection",
        "deptrac": "tools/deptrac/vendor/bin/deptrac analyse --config-file=deptrac.yaml --no-progress",
        "lint": [
            "@rector",
            "@phpcs",
            "@cache-version",
            "@phplint",
            "@phpunit",
            "@phpstan",
            "@deptrac"
        ]
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "extra": {
        "branch-alias": {
            "dev-2.x": "2.x-dev"
        },
        "laravel": {
            "providers": [
                "PHPRegex\\Laravel\\PHPRegexServiceProvider"
            ],
            "aliases": {
                "Regex": "PHPRegex\\Laravel\\Facades\\Regex"
            }
        },
        "phpstan": {
            "includes": [
                "extension.neon"
            ]
        },
        "ide": {
            "regex.dist.json": "./regex.schema.json"
        }
    },
    "suggest": {
        "psr/cache": "To share AST cache via PSR-6 pools.",
        "psr/simple-cache": "To share AST cache via PSR-16 caches.",
        "phpstan/phpstan": "To run static analysis and detect invalid regex patterns.",
        "nikic/php-parser": "To extract regex patterns from PHP sources with a real parser instead of the tokenizer.",
        "phpstan/extension-installer": "To automatically enable the PHPStan rule for regex validation.",
        "illuminate/support": "Required for Laravel integration.",
        "illuminate/console": "Required for Laravel Artisan commands.",
        "illuminate/routing": "Required for Laravel route analysis."
    }
}
