includes:
    - src/PHPStan/extension.neon
    - tools/phpstan/vendor/phpstan/phpstan/conf/bleedingEdge.neon
    - tools/phpstan/vendor/phpstan/phpstan-phpunit/extension.neon
    - tools/phpstan/vendor/phpstan/phpstan-phpunit/rules.neon
    - tools/phpstan/vendor/phpstan/phpstan-symfony/extension.neon
    - tools/phpstan/vendor/phpstan/phpstan-symfony/rules.neon
    - tools/phpstan/vendor/phpstan/phpstan-deprecation-rules/rules.neon
    - tools/phpstan/vendor/shipmonk/phpstan-rules/rules.neon
    - tools/phpstan/vendor/spaze/phpstan-disallowed-calls/extension.neon
    - tools/phpstan/vendor/spaze/phpstan-disallowed-calls/disallowed-loose-calls.neon
    - phpstan-baseline.neon

# Only the three rules of thecodingmachine/phpstan-strict-rules that fit this
# codebase are registered, by service: the plugin's full neon also wires
# MustRethrowRule and the superglobals ban, which fight the boundary catches
# (\Throwable at a CLI, cache or analysis boundary is this library's
# documented convention) and the CLI's legitimate $_SERVER reads.
services:
    -
        class: TheCodingMachine\PHPStan\Rules\Exceptions\ThrowMustBundlePreviousExceptionRule
        tags: [phpstan.rules.rule]
    -
        class: TheCodingMachine\PHPStan\Rules\Conditionals\SwitchMustContainDefaultRule
        tags: [phpstan.rules.rule]
    -
        class: TheCodingMachine\PHPStan\Rules\Exceptions\DoNotThrowExceptionBaseClassRule
        tags: [phpstan.rules.rule]

parameters:
    level: max

    tmpDir: .cache/phpstan

    treatPhpDocTypesAsCertain: false

    # The core packages and the PHPStan, Psalm and Rector bridges support 8.1
    # through 8.6, the Symfony and Laravel bridges 8.2 through 8.6; the whole
    # code is written for 8.1, so analysing the whole range here reports any
    # newer syntax or function left behind.
    phpVersion:
        min: 80100
        max: 80699

    # The tests probe the running engine behind version guards: judge their
    # patterns for the PHP running the analysis, not for the 8.2 floor.
    phpRegex:
        phpVersion: runtime
        # Every mixed type src/ declares is held to this baseline, each entry
        # giving the reason the type stays mixed; it only goes down.
        noNewMixed:
            enabled: true
            baseline: %currentWorkingDirectory%/phpstan-mixed-baseline.php
            paths:
                - %currentWorkingDirectory%/src

    # Absolute strictness for local development: the benevolent unions, the
    # implicit mixed and the too-wide public return shapes level max tolerates
    # are reported here, so what CI's floor would accept still shows at home.
    checkBenevolentUnionTypes: true
    checkImplicitMixed: true
    checkTooWideReturnTypesInProtectedAndPublicMethods: true

    # Opt-in subset of shipmonk/phpstan-rules: each rule is a conscious
    # choice, the style-flavoured ones (forbidVariableTypeOverwriting,
    # forbidUnusedClosureParameters) measured as pure idiom on this codebase.
    # reportInsideIsset stays off: an offset read through "?? null" already
    # swallows the null key the rule would report.
    shipmonkRules:
        enableAllRules: false
        forbidFetchOnMixed:
            enabled: true
        forbidMethodCallOnMixed:
            enabled: true
        forbidNullInBinaryOperations:
            enabled: true
        forbidUnsafeArrayKey:
            enabled: true
            reportInsideIsset: false
        forbidIncrementDecrementOnNonInteger:
            enabled: true
        forbidArithmeticOperationOnNonNumber:
            enabled: true
        forbidPhpDocNullabilityMismatchWithNativeTypehint:
            enabled: true

    # Debug output has no place in a shipped library; the rendering forms
    # (second argument true) stay allowed, as assertions build messages
    # with them.
    disallowedFunctionCalls:
        -
            function: 'dump()'
        -
            function: 'dd()'
        -
            function: 'var_dump()'
        -
            function: 'print_r()'
            allowParamsAnywhere:
                2: true
        -
            function: 'var_export()'
            allowParamsAnywhere:
                2: true

    paths:
        - bin
        - src
        - tests

    # bin/corpus and bin/corpus-lint have no .php extension, so paths above do
    # not parse them; scan them so their functions exist for the tests that
    # require them.
    scanFiles:
        - bin/corpus
        - bin/corpus-lint

    # The benchmarks' attributes live in the phpbench tool's own vendor.
    scanDirectories:
        - tools/phpbench/vendor/phpbench/phpbench/lib/Attributes

    bootstrapFiles:
        - tools/phpunit/vendor/autoload.php

    excludePaths:
        - tests/Benchmark/Fixtures/*
        - tests/Fixtures/*
        - tests/Integration/Bridge/PHPStan/Fixtures/
        # Psalm reads these, invalid patterns and all
        - tests/Integration/Bridge/Psalm/Fixtures/
        - tests/Tools/validate_library.php
        # The Rector set is read by Rector, whose classes live in its own vendor
        - src/Toolkit/Resources/rector/*


    editorUrl: 'phpstorm://open?file=%%file%%&line=%%line%%'

    ignoreErrors:
        # Three entries live here because no single machine can see them
        # whole; everything else the analysis still tolerates is named,
        # one finding per line, in phpstan-baseline.neon: fix a finding,
        # regenerate the baseline, the line goes.
        #
        # PHPUnit 13 deprecates expectExceptionMessage() for
        # expectExceptionMessageIs(), which PHPUnit 10.5 to 12 do not have;
        # the suite runs on all four, so the call stays until 12 is the
        # oldest PHPUnit it runs on. The tools install PHPUnit 13 only on the
        # PHP that takes it.
        - message: '#^Call to deprecated method expectExceptionMessage\(\) of class PHPUnit\\Framework\\TestCase#'
          identifier: method.deprecated
          path: tests/*
          reportUnmatched: false
        #
        # Symfony 8.1 validates through validateInContext(); the bundle also
        # supports 7.4, which has no such method, so the test drives the
        # validator through initialize() and validate() there. Symfony 7.4,
        # the one PHP 8.2 and 8.3 install, deprecates neither.
        - message: '#^Call to deprecated method (initialize|validate)\(\)#'
          identifier: method.deprecated
          path: tests/Unit/Bridge/Symfony/Validator/ValidRegexValidatorTest.php
          reportUnmatched: false
        # These tests probe the running engine for syntax newer PCRE2 releases
        # added, as (?[...]), (*scs:...), (?^i), a \K inside a lookbehind or a
        # group name past 32 code units, and only match with it when it
        # compiles: the analysis, run on an older PCRE2, cannot compile them.
        # Revisit once PHPStan's own regexp rule learns to read the engine
        # version instead of refusing. On a recent PCRE2 every pattern
        # compiles and nothing is left to ignore.
        - identifiers:
            - regexp.pattern
          reportUnmatched: false
          paths:
            - tests/Integration/Bridge/PHPStan/RegexPatternRuleExtensionNeonRangeTest.php
            - tests/Integration/Bridge/PHPStan/RegexPatternRuleReplacementGroupEdgeTest.php
            - tests/Integration/Bridge/PHPStan/RegexPatternRuleTargetMarkerTest.php
            - tests/Unit/Automata/SolverOnHirAdversaryFixesTest.php
            - tests/Unit/Hir/ClassSetProviderCacheTest.php
            - tests/Unit/Internal/InlineFlagsTest.php
            - tests/Unit/Internal/StartOptionsTest.php
            - tests/Unit/Lint/AnalysisServiceGuardTest.php
            - tests/Unit/Lint/Rule/ImpossibleLookaroundRuleTest.php
            - tests/Unit/Lint/Rule/PossessiveImpossibleRuleTest.php
            - tests/Unit/NodeVisitor/CasingSettingsTest.php
            - tests/Unit/NodeVisitor/ExtendedCharClassDisplayTest.php
            - tests/Unit/NodeVisitor/KeepInLookaroundTest.php
            - tests/Unit/NodeVisitor/SampleGeneratorEndAnchorTest.php
            - tests/Unit/NodeVisitor/SampleGeneratorVisitorTest.php
            - tests/Unit/Parser/ExtendedCharClassTest.php
            - tests/Unit/Parser/GroupNameLengthReleaseTest.php
            - tests/Unit/Parser/Printer/PatternFormatterTest.php
            - tests/Unit/Parser/ScanSubstringTest.php
            - tests/Unit/Parser/ValidationHintTest.php
            - tests/Unit/Redos/Proven/RedosInlineOptionsTest.php

    reportUnmatchedIgnoredErrors: true
