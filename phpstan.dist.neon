includes:
    - src/PHPStan/extension.neon
    - tools/phpstan/vendor/phpstan/phpstan/conf/bleedingEdge.neon
    - tools/phpstan/vendor/phpstan/phpstan-phpunit/extension.neon
    - tools/phpstan/vendor/phpstan/phpstan-phpunit/rules.neon
    - tools/phpstan/vendor/phpstan/phpstan-symfony/extension.neon
    - tools/phpstan/vendor/phpstan/phpstan-symfony/rules.neon
    - tools/phpstan/vendor/phpstan/phpstan-deprecation-rules/rules.neon
    - tools/phpstan/vendor/shipmonk/phpstan-rules/rules.neon
    - tools/phpstan/vendor/spaze/phpstan-disallowed-calls/extension.neon
    - tools/phpstan/vendor/spaze/phpstan-disallowed-calls/disallowed-loose-calls.neon

# Only the three rules of thecodingmachine/phpstan-strict-rules that fit this
# codebase are registered, by service: the plugin's full neon also wires
# MustRethrowRule and the superglobals ban, which fight the boundary catches
# (\Throwable at a CLI, cache or analysis boundary is this library's
# documented convention) and the CLI's legitimate $_SERVER reads.
services:
    -
        class: TheCodingMachine\PHPStan\Rules\Exceptions\ThrowMustBundlePreviousExceptionRule
        tags: [phpstan.rules.rule]
    -
        class: TheCodingMachine\PHPStan\Rules\Conditionals\SwitchMustContainDefaultRule
        tags: [phpstan.rules.rule]
    -
        class: TheCodingMachine\PHPStan\Rules\Exceptions\DoNotThrowExceptionBaseClassRule
        tags: [phpstan.rules.rule]

parameters:
    level: max

    tmpDir: .cache/phpstan

    treatPhpDocTypesAsCertain: false

    # The core packages and the PHPStan, Psalm and Rector bridges support 8.1
    # through 8.6, the Symfony and Laravel bridges 8.2 through 8.6; the whole
    # code is written for 8.1, so analysing the whole range here reports any
    # newer syntax or function left behind.
    phpVersion:
        min: 80100
        max: 80699

    # The tests probe the running engine behind version guards: judge their
    # patterns for the PHP running the analysis, not for the 8.2 floor.
    phpRegex:
        phpVersion: runtime

    # Absolute strictness for local development: the benevolent unions, the
    # implicit mixed and the too-wide public return shapes level max tolerates
    # are reported here, so what CI's floor would accept still shows at home.
    checkBenevolentUnionTypes: true
    checkImplicitMixed: true
    checkTooWideReturnTypesInProtectedAndPublicMethods: true

    # Opt-in subset of shipmonk/phpstan-rules: each rule is a conscious
    # choice, the style-flavoured ones (forbidVariableTypeOverwriting,
    # forbidUnusedClosureParameters) measured as pure idiom on this codebase.
    # reportInsideIsset stays off: an offset read through "?? null" already
    # swallows the null key the rule would report.
    shipmonkRules:
        enableAllRules: false
        forbidFetchOnMixed:
            enabled: true
        forbidMethodCallOnMixed:
            enabled: true
        forbidNullInBinaryOperations:
            enabled: true
        forbidUnsafeArrayKey:
            enabled: true
            reportInsideIsset: false
        forbidIncrementDecrementOnNonInteger:
            enabled: true
        forbidArithmeticOperationOnNonNumber:
            enabled: true
        forbidPhpDocNullabilityMismatchWithNativeTypehint:
            enabled: true

    # Debug output has no place in a shipped library; the rendering forms
    # (second argument true) stay allowed, as assertions build messages
    # with them.
    disallowedFunctionCalls:
        -
            function: 'dump()'
        -
            function: 'dd()'
        -
            function: 'var_dump()'
        -
            function: 'print_r()'
            allowParamsAnywhere:
                2: true
        -
            function: 'var_export()'
            allowParamsAnywhere:
                2: true

    paths:
        - bin
        - src
        - tests

    # bin/corpus and bin/corpus-lint have no .php extension, so paths above do
    # not parse them; scan them so their functions exist for the tests that
    # require them.
    scanFiles:
        - bin/corpus
        - bin/corpus-lint

    # The benchmarks' attributes live in the phpbench tool's own vendor.
    scanDirectories:
        - tools/phpbench/vendor/phpbench/phpbench/lib/Attributes

    bootstrapFiles:
        - tools/phpunit/vendor/autoload.php

    excludePaths:
        - tests/Benchmark/Fixtures/*
        - tests/Fixtures/*
        - tests/Integration/Bridge/PHPStan/Fixtures/
        # Psalm reads these, invalid patterns and all
        - tests/Integration/Bridge/Psalm/Fixtures/
        - tests/Tools/validate_library.php
        # Laravel bridge - requires illuminate/* packages which are optional
        - src/Laravel/*
        - tests/Integration/Bridge/Laravel/*
        # The Rector set is read by Rector, whose classes live in its own vendor
        - src/Toolkit/Resources/rector/*


    editorUrl: 'phpstorm://open?file=%%file%%&line=%%line%%'

    ignoreErrors:
        # The test of the engine version skips asserts every skip message
        # verbatim by catching the skip: the class is PHPUnit-internal, its
        # message is the very contract under test.
        - identifier: catch.internalClass
          path: tests/Unit/Support/PcreGatesTest.php
        # Symfony 8.1 validates through validateInContext(); the bundle also
        # supports 7.4, which has no such method, so the test drives the
        # validator through initialize() and validate() there. Symfony 7.4,
        # the one PHP 8.2 and 8.3 install, deprecates neither.
        - identifier: method.deprecated
          path: tests/Unit/Bridge/Symfony/Validator/ValidRegexValidatorTest.php
          reportUnmatched: false
        # The worker pool test hands run() a chunk result that is not a list on
        # purpose: it is the only way to reach the guard that refuses one.
        - message: '#^Unable to resolve the template type R in call to method PHPRegex\\Linter\\Internal\\ForkedWorkerPool::run\(\)$#'
          identifier: argument.templateType
          path: tests/Unit/Lint/ForkedWorkerPoolTest.php
          count: 1
        - message: '#^Parameter \#3 \$work of method PHPRegex\\Linter\\Internal\\ForkedWorkerPool::run\(\) expects .+ ''not a list'' given\.$#'
          identifier: argument.type
          path: tests/Unit/Lint/ForkedWorkerPoolTest.php
          count: 1
        # The memory reserve of a JSON run is only ever freed, when PHP stops
        # the run: holding it is its whole use.
        - message: '#^Static property PHPRegex\\Cli\\Application::\$memoryReserve is never read, only written\.$#'
          identifier: property.onlyWritten
          path: src/Cli/Application.php
        - identifiers:
            - classConstant.internalClass
            # PHPUnit assertions that PHPStan considers redundant
            - method.alreadyNarrowedType
        # The benchmarks run on the PHP of the machine that measures, 8.2 or
        # later, and a test that measures a peak skips below 8.2: each resets
        # the peak it reports.
        - message: '#^Function memory_reset_peak_usage not found\.$#'
          identifier: function.notFound
          paths:
            - tests/Benchmark/*
            - tests/Unit/Lint/Extraction/ResolutionLimitsTest.php
        # The bare (?flags) predicate does real work beyond the type it
        # asserts (group type, flags, span), so an argument already narrowed
        # to GroupNode does not make the call always true: visitGroup()
        # receives every group kind, the wrapper loop of PossessiveImpossible
        # Rule stops at the standalone (?flags) group, and the regression
        # test feeds the predicate the scoped group it must answer no to.
        - message: '#^Call to static method PHPRegex\\Linter\\Rule\\Support\\NodePredicates::isStandaloneInlineFlagsGroup\(\) with PHPRegex\\Parser\\Node\\GroupNode will always evaluate to true\.$#'
          identifier: staticMethod.alreadyNarrowedType
        # These tests probe the running engine for syntax newer PCRE2 releases
        # added, as (?[...]), (*scs:...), (?^i) or a \K inside a lookbehind,
        # and only match with it when it compiles: the analysis, run on an
        # older PCRE2, cannot compile them. Revisit once PHPStan's own regexp
        # rule learns to read the engine version instead of refusing. On a
        # recent PCRE2 every pattern compiles and nothing is left to ignore.
        - identifiers:
            - regexp.pattern
          reportUnmatched: false
          paths:
            - tests/Integration/Bridge/PHPStan/RegexPatternRuleExtensionNeonRangeTest.php
            - tests/Integration/Bridge/PHPStan/RegexPatternRuleReplacementGroupEdgeTest.php
            - tests/Integration/Bridge/PHPStan/RegexPatternRuleTargetVersionTest.php
            - tests/Unit/Automata/DfaCacheKeyVersionTest.php
            - tests/Unit/Automata/SolverOnHirAdversaryFixesTest.php
            - tests/Unit/Hir/ClassSetProviderCacheTest.php
            - tests/Unit/Internal/InlineFlagsTest.php
            - tests/Unit/Internal/StartOptionsTest.php
            - tests/Unit/Lint/Rule/ImpossibleLookaroundRuleTest.php
            - tests/Unit/Lint/Rule/PossessiveImpossibleRuleTest.php
            - tests/Unit/NodeVisitor/CasingSettingsTest.php
            - tests/Unit/NodeVisitor/ExtendedCharClassDisplayTest.php
            - tests/Unit/NodeVisitor/SampleGeneratorEndAnchorTest.php
            - tests/Unit/NodeVisitor/SampleGeneratorVisitorTest.php
            - tests/Unit/Parser/ExtendedCharClassTest.php
            - tests/Unit/Parser/GroupNameLengthReleaseTest.php
            - tests/Unit/Parser/Printer/PatternFormatterTest.php
            - tests/Unit/Parser/ScanSubstringTest.php
            - tests/Unit/Parser/ValidationHintTest.php
            - tests/Unit/Redos/Proven/RedosInlineOptionsTest.php
        # Two tests hand preg_match() flags outside its stub on purpose: a bit
        # PHP refuses (PREG_SET_ORDER and the like) and one it ignores (1024).
        - message: '#^Parameter \#4 \$flags of function preg_match expects #'
          identifier: argument.type
          path: tests/Unit/Parser/CaptureShapeAnalyzerTest.php
          count: 2
        # The replacement test asks the engine what a reference to a missing
        # group gives: those calls are the ones the rule reports, on purpose.
        - identifier: regex.replacement.undefinedGroup
          path: tests/Integration/Bridge/PHPStan/RegexPatternRuleReplacementGroupTest.php
        # The contract test pins what the types already say: the replace,
        # split and brace rules have no PHP floor, and a later change must
        # not add one.
        - identifier: function.impossibleType
          path: tests/Integration/Bridge/Rector/RuleContractTest.php
          count: 3

        # The accessor test pins absence: the deprecated isValid() and
        # getErrorMessage() must stay gone, and a later change must not
        # reintroduce them.
        - identifier: function.impossibleType
          path: tests/Unit/ValidationResultTest.php
          count: 2
        # The interface test pins what the types already say: ParserException
        # implements VisualContextInterface, and a later change must not
        # drop it.
        - identifier: function.alreadyNarrowedType
          path: tests/Unit/ParserExceptionTest.php
        # ── shipmonk ratchet ────────────────────────────────────────────────
        # The null-binary findings left in tests build failure messages
        # ("line " . $error->getLine(), where a null renders as '') and feed
        # usort comparators whose operands the tests always set: cosmetics,
        # not defects. Pinned with a count so the number only goes down; the
        # src/ sites were all fixed (guards, never casts).
        -
            identifier: shipmonk.binaryOperationWithNull
            path: tests/*
            count: 26
        # The node test hands the constructor the legacy 3-argument int form
        # on purpose: the TypeError it now raises is the pinned contract.
        - message: '#^Call to new PHPRegex\\Parser\\Node\\UnicodePropNode\(\) on a separate line has no effect\.$#'
          identifier: new.resultUnused
          path: tests/Unit/Node/UnicodePropNodeTest.php
        - message: '#^Parameter \#2 \$hasBraces of class PHPRegex\\Parser\\Node\\UnicodePropNode constructor expects bool, int given\.$#'
          identifier: argument.type
          path: tests/Unit/Node/UnicodePropNodeTest.php

        # The Psalm plugin's tests drive Psalm in this process, through its
        # project analyser, issue buffer and type comparator, which Psalm
        # marks internal: there is no public API to run an analysis.
        - identifiers:
            - method.internalClass
            - new.internalClass
            - parameter.internalClass
            - property.internal
            - property.internalClass
            - return.internalClass
            - staticMethod.internalClass
          path: tests/Integration/Bridge/Psalm/*

        # The Psalm plugin narrows $matches through Psalm's node data and
        # resolves a namespaced function name as Psalm does, through classes
        # Psalm marks internal: no public API sets an assertion on a call. The
        # instanceof and method_exists() guards are the point, should a minor
        # Psalm release move them.
        - identifier: instanceof.internalClass
          path: src/Psalm/Internal/PregCallAnalyzer.php
          count: 4
        - identifier: method.internalClass
          path: src/Psalm/Internal/PregCallAnalyzer.php
          count: 5
        # Psalm asks for the parameters of preg_replace_callback() before it
        # analyses the arguments: the plugin reads the stub's through the
        # statements analyser, and analyses in place an argument that writes
        # nothing, as Psalm's own ArgTypeInferer does.
        - identifier: staticMethod.internalClass
          path: src/Psalm/Internal/PregCallAnalyzer.php
          count: 1
        - identifier: instanceof.internalClass
          path: src/Psalm/Internal/CallbackParameters.php
          count: 1
        - message: '#^Call to function method_exists\(\) with Psalm\\Internal\\#'
          identifier: function.alreadyNarrowedType
          path: src/Psalm/Internal/PregCallAnalyzer.php
          count: 5

    reportUnmatchedIgnoredErrors: true
