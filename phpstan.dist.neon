includes:
    - extension.neon
    - tools/phpstan/vendor/phpstan/phpstan/conf/bleedingEdge.neon
    - tools/phpstan/vendor/phpstan/phpstan-phpunit/extension.neon
    - tools/phpstan/vendor/phpstan/phpstan-symfony/extension.neon
    - tools/phpstan/vendor/phpstan/phpstan-symfony/rules.neon

parameters:
    level: max

    tmpDir: .cache/phpstan

    treatPhpDocTypesAsCertain: false

    # The package supports 8.2 through 8.6 and CI analyses each of them, so
    # analysing the whole range here says locally what CI would say.
    phpVersion:
        min: 80200
        max: 80599

    # The tests probe the running engine behind version guards: judge their
    # patterns for the PHP running the analysis, not for the 8.2 floor.
    regexParser:
        phpVersion: runtime

    paths:
        - bin
        - src
        - tests

    bootstrapFiles:
        - tools/phpunit/vendor/autoload.php

    excludePaths:
        - tests/Benchmark/*
        - tests/Fixtures/*
        - tests/Integration/Bridge/PHPStan/Fixtures/
        - tests/Tools/extract_pcre_tests.php
        - tests/Tools/validate_library.php
        # Laravel bridge - requires illuminate/* packages which are optional
        - src/Bridge/Laravel/*
        - tests/Integration/Bridge/Laravel/*


    editorUrl: 'phpstorm://open?file=%%file%%&line=%%line%%'

    ignoreErrors:
        - identifiers:
            - classConstant.internalClass
            # Unicode lint rules are style warnings - too noisy for our codebase
            # Many patterns intentionally use ASCII-only matching
            - regex.lint.unicode.shorthandWithoutU
            # PHPUnit assertions that PHPStan considers redundant
            - method.alreadyNarrowedType

    reportUnmatchedIgnoredErrors: false
