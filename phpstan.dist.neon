includes:
    - src/PHPStan/extension.neon
    - tools/phpstan/vendor/phpstan/phpstan/conf/bleedingEdge.neon
    - tools/phpstan/vendor/phpstan/phpstan-phpunit/extension.neon
    - tools/phpstan/vendor/phpstan/phpstan-symfony/extension.neon
    - tools/phpstan/vendor/phpstan/phpstan-symfony/rules.neon

parameters:
    level: max

    tmpDir: .cache/phpstan

    treatPhpDocTypesAsCertain: false

    # The package supports 8.2 through 8.6 and CI analyses each of them, so
    # analysing the whole range here says locally what CI would say.
    phpVersion:
        min: 80200
        max: 80599

    # The tests probe the running engine behind version guards: judge their
    # patterns for the PHP running the analysis, not for the 8.2 floor.
    phpRegex:
        phpVersion: runtime

    paths:
        - bin
        - src
        - tests

    # bin/corpus has no .php extension, so paths above do not parse it; scan it
    # so its functions (deriveTargetPath, normalizeCloneUrl, ...) exist for the
    # tests that require it.
    scanFiles:
        - bin/corpus

    bootstrapFiles:
        - tools/phpunit/vendor/autoload.php

    excludePaths:
        - tests/Benchmark/*
        - tests/Fixtures/*
        - tests/Integration/Bridge/PHPStan/Fixtures/
        # Psalm reads these, invalid patterns and all
        - tests/Integration/Bridge/Psalm/Fixtures/
        - tests/Tools/extract_pcre_tests.php
        - tests/Tools/validate_library.php
        # Laravel bridge - requires illuminate/* packages which are optional
        - src/Laravel/*
        - tests/Integration/Bridge/Laravel/*
        # The Rector set is read by Rector, whose classes live in its own vendor
        - src/Toolkit/Resources/rector/*


    editorUrl: 'phpstorm://open?file=%%file%%&line=%%line%%'

    ignoreErrors:
        # The memory reserve of a JSON run is only ever freed, when PHP stops
        # the run: holding it is its whole use.
        - message: '#^Static property PHPRegex\\Cli\\Application::\$memoryReserve is never read, only written\.$#'
          identifier: property.onlyWritten
          path: src/Cli/Application.php
        - identifiers:
            - classConstant.internalClass
            # Unicode lint rules are style warnings - too noisy for our codebase
            # Many patterns intentionally use ASCII-only matching
            - regex.lint.unicode.shorthandWithoutU
            # PHPUnit assertions that PHPStan considers redundant
            - method.alreadyNarrowedType
        # These tests probe the running engine for syntax newer PCRE2 releases
        # added, as (?[...]) or (*scs:...), and only match with it when it
        # compiles: the analysis, run on an older PCRE2, cannot compile them.
        - identifiers:
            - regexp.pattern
          paths:
            - tests/Integration/Bridge/PHPStan/RegexParserRuleTargetVersionTest.php
            - tests/Unit/Automata/DfaCacheKeyVersionTest.php
            - tests/Unit/Automata/SolverOnHirAdversaryFixesTest.php
            - tests/Unit/Hir/ClassSetProviderCacheTest.php
            - tests/Unit/Internal/InlineFlagsTest.php
            - tests/Unit/Internal/StartOptionsTest.php
            - tests/Unit/NodeVisitor/CasingSettingsTest.php
            - tests/Unit/NodeVisitor/ExtendedCharClassDisplayTest.php
            - tests/Unit/NodeVisitor/SampleGeneratorEndAnchorTest.php
            - tests/Unit/NodeVisitor/SampleGeneratorVisitorTest.php
            - tests/Unit/Parser/ExtendedCharClassTest.php
            - tests/Unit/Parser/GroupNameLengthReleaseTest.php
            - tests/Unit/Parser/ScanSubstringTest.php
            - tests/Unit/ReDoS/Proven/RedosInlineOptionsTest.php
        # Two tests hand preg_match() flags outside its stub on purpose: a bit
        # PHP refuses (PREG_SET_ORDER and the like) and one it ignores (1024).
        - message: '#^Parameter \#4 \$flags of function preg_match expects #'
          identifier: argument.type
          path: tests/Unit/Parser/CaptureShapeAnalyzerTest.php
          count: 2
        # The contract test pins what the types already say: the replace and
        # split rules have no PHP floor, and a later change must not add one.
        - identifier: function.impossibleType
          path: tests/Integration/Bridge/Rector/RuleContractTest.php
          count: 2

        # The Psalm plugin's tests drive Psalm in this process, through its
        # project analyser, issue buffer and type comparator, which Psalm
        # marks internal: there is no public API to run an analysis.
        - identifiers:
            - method.internalClass
            - new.internalClass
            - parameter.internalClass
            - property.internal
            - property.internalClass
            - return.internalClass
            - staticMethod.internalClass
          path: tests/Integration/Bridge/Psalm/*

        # The Psalm plugin narrows $matches through Psalm's node data and
        # resolves a namespaced function name as Psalm does, through classes
        # Psalm marks internal: no public API sets an assertion on a call. The
        # instanceof and method_exists() guards are the point, should a minor
        # Psalm release move them.
        - identifier: instanceof.internalClass
          path: src/Psalm/Internal/PregCallAnalyzer.php
          count: 3
        - identifier: method.internalClass
          path: src/Psalm/Internal/PregCallAnalyzer.php
          count: 5
        - message: '#^Call to function method_exists\(\) with Psalm\\Internal\\#'
          identifier: function.alreadyNarrowedType
          path: src/Psalm/Internal/PregCallAnalyzer.php
          count: 5

    reportUnmatchedIgnoredErrors: false
